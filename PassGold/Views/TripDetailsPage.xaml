<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:PassGold.Helpers"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             xmlns:viewmodels="clr-namespace:PassGold.ViewModels"
             x:Class="PassGold.Views.TripDetailsPage"
             Title="{helpers:Translate TripDetails_Title}"
             BackgroundColor="{AppThemeBinding Light=#F5F7FA, Dark=#121212}">

    <Grid>
        <Grid RowDefinitions="Auto, Auto, *">
            <VerticalStackLayout Grid.Row="0" Margin="20,20,20,10" Spacing="10">
                <Label Text="{helpers:Translate TripDetails_LogisticsTitle}" FontSize="22" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                <Label Text="{helpers:Translate TripDetails_AllFleet}" FontSize="12" TextColor="Gray" IsVisible="{Binding HayMultiplesChoferes}"/>
                <Border IsVisible="{Binding HayMultiplesChoferes}" Stroke="{StaticResource Primary}" StrokeThickness="1" StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}">
                    <Picker ItemsSource="{Binding ChoferesAsignados}" ItemDisplayBinding="{Binding DisplayName}" SelectedItem="{Binding ChoferSeleccionado}" Title="{helpers:Translate TripDetails_SelectDriver}" Margin="10,0" TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"/>
                </Border>
            </VerticalStackLayout>

            <Grid Grid.Row="1" ColumnDefinitions="*, *, *" Margin="20,10" ColumnSpacing="5">
                <Button Grid.Column="0" Text="{helpers:Translate TripDetails_TabPassengers}" Command="{Binding CambiarPestanaCommand}" CommandParameter="Pasajeros" BackgroundColor="{Binding IsPasajerosTab, Converter={StaticResource BoolToColorConverter}, ConverterParameter='Primary|Transparent'}" TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}" CornerRadius="8" FontSize="12" FontAttributes="Bold" Padding="0"/>
                <Button Grid.Column="1" Text="{helpers:Translate TripDetails_TabMap}" Command="{Binding CambiarPestanaCommand}" CommandParameter="Mapa" BackgroundColor="{Binding IsMapaTab, Converter={StaticResource BoolToColorConverter}, ConverterParameter='Primary|Transparent'}" TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}" CornerRadius="8" FontSize="12" FontAttributes="Bold" Padding="0"/>
                <Button Grid.Column="2" Text="{helpers:Translate TripDetails_TabOperator}" Command="{Binding CambiarPestanaCommand}" CommandParameter="Operador" BackgroundColor="{Binding IsOperadorTab, Converter={StaticResource BoolToColorConverter}, ConverterParameter='Primary|Transparent'}" TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}" CornerRadius="8" FontSize="12" FontAttributes="Bold" Padding="0"/>
            </Grid>

            <Grid Grid.Row="2" Margin="20,10">
                <Grid.GestureRecognizers>
                    <SwipeGestureRecognizer Direction="Left" Command="{Binding SwipeLeftCommand}" />
                    <SwipeGestureRecognizer Direction="Right" Command="{Binding SwipeRightCommand}" />
                </Grid.GestureRecognizers>

                <!-- LISTA DE PASAJEROS -->
                <ScrollView IsVisible="{Binding IsPasajerosTab}">
                    <VerticalStackLayout Spacing="10" Padding="0,0,0,20">
                        <Label Text="{helpers:Translate TripDetails_BoardingList}" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                        <Label IsVisible="{Binding ListaVacia}" Text="{helpers:Translate TripDetails_NoPassengers}" TextColor="Gray" HorizontalOptions="Center" Margin="0,20"/>

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Pasajeros}" Spacing="10">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}" Padding="10" StrokeThickness="0">
                                        <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="10">

                                            <!-- Foto -->
                                            <Border Grid.Column="0" WidthRequest="40" HeightRequest="40" StrokeShape="RoundRectangle 20" BackgroundColor="#E0E0E0" StrokeThickness="0" VerticalOptions="Center">
                                                <Grid>
                                                    <Label Text="🎓" HorizontalOptions="Center" VerticalOptions="Center" FontSize="18" IsVisible="{Binding FotoUrl, Converter={StaticResource StringToBoolInvertedConverter}}"/>
                                                    <Image Source="{Binding FotoUrl}" Aspect="AspectFill" IsVisible="{Binding FotoUrl, Converter={StaticResource StringToBoolConverter}}"/>
                                                </Grid>
                                            </Border>

                                            <!-- Info -->
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                                <Label Text="{Binding Nombre}" FontAttributes="Bold" FontSize="14" TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"/>
                                                <Label Text="{Binding Ubicacion}" FontSize="11" TextColor="Gray" LineBreakMode="TailTruncation" MaxLines="2"/>
                                            </VerticalStackLayout>

                                            <!-- NUEVO: Botón Ubicar -->
                                            <Button Grid.Column="2" Text="📍" Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:TripDetailsViewModel}}, Path=UbicarEnMapaCommand}" CommandParameter="{Binding .}" BackgroundColor="{AppThemeBinding Light=#E3F2FD, Dark=#1E3A5F}" TextColor="{StaticResource Primary}" WidthRequest="40" HeightRequest="40" CornerRadius="20" Padding="0" FontSize="16" VerticalOptions="Center"/>

                                            <!-- NUEVO: Botón Contactar -->
                                            <Button Grid.Column="3" Text="📞" Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:TripDetailsViewModel}}, Path=ContactarPasajeroCommand}" CommandParameter="{Binding .}" BackgroundColor="{AppThemeBinding Light=#E8F5E9, Dark=#1B3B1D}" TextColor="#2E7D32" WidthRequest="40" HeightRequest="40" CornerRadius="20" Padding="0" FontSize="16" VerticalOptions="Center"/>

                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>

                <!-- MAPA TAB -->
                <Grid IsVisible="{Binding IsMapaTab}" RowDefinitions="Auto, Auto, *">
                    <Label Grid.Row="0" Text="{helpers:Translate TripDetails_RealTimeRoute}" FontSize="16" FontAttributes="Bold" Margin="0,0,0,10" TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                    <Grid Grid.Row="1" ColumnDefinitions="*, *" ColumnSpacing="5" Margin="0,0,0,10">
                        <Button Grid.Column="0" Text="{helpers:Translate TripDetails_TabPickup}" Command="{Binding CambiarSubTabMapaCommand}" CommandParameter="Recogida" BackgroundColor="{Binding IsMapaSubTabRecogida, Converter={StaticResource BoolToColorConverter}, ConverterParameter='Primary|Transparent'}" TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}" CornerRadius="8" FontSize="12" FontAttributes="Bold" Padding="0"/>
                        <Button Grid.Column="1" Text="{helpers:Translate TripDetails_TabDropoff}" Command="{Binding CambiarSubTabMapaCommand}" CommandParameter="Bajada" BackgroundColor="{Binding IsMapaSubTabRecogida, Converter={StaticResource BoolToColorConverter}, ConverterParameter='Transparent|Primary'}" TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}" CornerRadius="8" FontSize="12" FontAttributes="Bold" Padding="0"/>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Border StrokeShape="RoundRectangle 12" StrokeThickness="2" Stroke="{StaticResource Primary}" BackgroundColor="{AppThemeBinding Light=#EAEAEA, Dark=#2A2A2A}">
                            <maps:Map x:Name="MapaRutaEnVivo" IsShowingUser="True" MapType="{Binding CurrentMapType}" />
                        </Border>

                        <!-- NUEVO: Mensaje No Wi-Fi sobre el mapa -->
                        <Border IsVisible="{Binding HayConexion, Converter={StaticResource InvertedBoolConverter}}" BackgroundColor="#CC000000" StrokeThickness="0" StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                                <Label Text="📶" FontSize="40" HorizontalOptions="Center"/>
                                <Label Text="{helpers:Translate Global_NoInternetTitle}" FontAttributes="Bold" TextColor="White" FontSize="16" HorizontalOptions="Center"/>
                                <Label Text="{helpers:Translate TripDetails_NoInternetMap}" TextColor="#DDDDDD" FontSize="12" HorizontalTextAlignment="Center" Margin="20,0"/>
                            </VerticalStackLayout>
                        </Border>

                        <Button Text="⛶" FontSize="20" WidthRequest="45" HeightRequest="45" Padding="0" CornerRadius="22" BackgroundColor="#DD1E1E1E" TextColor="White" HorizontalOptions="End" VerticalOptions="Start" Margin="10" Clicked="AbrirPantallaCompleta_Clicked"/>
                        <Button Text="🛰️" Command="{Binding ToggleMapTypeCommand}" FontSize="18" WidthRequest="45" HeightRequest="45" Padding="0" CornerRadius="22" BackgroundColor="#DD1E1E1E" TextColor="White" HorizontalOptions="Start" VerticalOptions="Start" Margin="10"/>
                    </Grid>
                </Grid>

                <!-- OPERADOR TAB -->
                <ScrollView IsVisible="{Binding IsOperadorTab}">
                    <VerticalStackLayout Spacing="15">
                        <Label Text="{helpers:Translate TripDetails_UnitData}" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                        <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}" Padding="15">
                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="15">
                                <Border Grid.Column="0" WidthRequest="60" HeightRequest="60" StrokeShape="RoundRectangle 30" BackgroundColor="#E0E0E0" StrokeThickness="0">
                                    <Grid>
                                        <Label Text="👤" HorizontalOptions="Center" VerticalOptions="Center" FontSize="24" IsVisible="{Binding FotoChofer, Converter={StaticResource StringToBoolInvertedConverter}}"/>
                                        <Image Source="{Binding FotoChofer}" Aspect="AspectFill" IsVisible="{Binding FotoChofer, Converter={StaticResource StringToBoolConverter}}"/>
                                    </Grid>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label Text="{helpers:Translate TripDetails_AssignedDriver}" FontSize="12" TextColor="Gray"/>
                                    <Label Text="{Binding NombreChofer}" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                        <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}" Padding="15">
                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="15">
                                <Border Grid.Column="0" WidthRequest="60" HeightRequest="60" StrokeShape="RoundRectangle 10" BackgroundColor="#E0E0E0" StrokeThickness="0">
                                    <Grid>
                                        <Label Text="🚐" HorizontalOptions="Center" VerticalOptions="Center" FontSize="24" IsVisible="{Binding FotoVehiculo, Converter={StaticResource StringToBoolInvertedConverter}}"/>
                                        <Image Source="{Binding FotoVehiculo}" Aspect="AspectFill" IsVisible="{Binding FotoVehiculo, Converter={StaticResource StringToBoolConverter}}"/>
                                    </Grid>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label Text="{helpers:Translate TripDetails_TransportUnit}" FontSize="12" TextColor="Gray"/>
                                    <Label Text="{Binding PlacaVehiculo}" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"/>
                                    <Label Text="{Binding CapacidadVehiculo, StringFormat={helpers:Translate TripDetails_CapacityMaxFormat}}" FontSize="12" TextColor="Gray"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </ScrollView>

            </Grid>
        </Grid>

        <!-- MAPA PANTALLA COMPLETA -->
        <Grid IsVisible="{Binding IsMapaPantallaCompleta}" RowDefinitions="Auto, *" BackgroundColor="{AppThemeBinding Light=#F5F7FA, Dark=#121212}">
            <Border Grid.Row="0" Margin="15,15,15,10" Stroke="{StaticResource Primary}" StrokeShape="RoundRectangle 25" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}">
                <Grid ColumnDefinitions="*, Auto">
                    <SearchBar Grid.Column="0" Placeholder="{helpers:Translate TripDetails_SearchPassengerPrompt}" TextChanged="BuscadorPasajeros_TextChanged" BackgroundColor="Transparent"/>
                    <Button Grid.Column="1" Text="✕" FontSize="18" WidthRequest="40" HeightRequest="40" Padding="0" BackgroundColor="Transparent" TextColor="{StaticResource Primary}" FontAttributes="Bold" Clicked="CerrarPantallaCompleta_Clicked"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <maps:Map x:Name="MapaPantallaCompleta" IsShowingUser="True" MapType="{Binding CurrentMapType}" />
                <Button Text="🛰️" Command="{Binding ToggleMapTypeCommand}" FontSize="18" WidthRequest="45" HeightRequest="45" Padding="0" CornerRadius="22" BackgroundColor="#DD1E1E1E" TextColor="White" HorizontalOptions="Start" VerticalOptions="Start" Margin="10"/>

                <Border IsVisible="{Binding HayConexion, Converter={StaticResource InvertedBoolConverter}}" BackgroundColor="#CC000000" StrokeThickness="0">
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                        <Label Text="📶" FontSize="50" HorizontalOptions="Center"/>
                        <Label Text="{helpers:Translate Global_OfflineMode}" FontAttributes="Bold" TextColor="White" FontSize="20" HorizontalOptions="Center"/>
                        <Label Text="{helpers:Translate TripDetails_OfflineMapDesc}" TextColor="#DDDDDD" FontSize="14" HorizontalTextAlignment="Center" Margin="20,0"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>