<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:PassGold.Helpers"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             x:Class="PassGold.Views.ScheduleTripPage"
             xmlns:viewmodels="clr-namespace:PassGold.ViewModels"
             Title="{helpers:Translate Schedule_Title}"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightBg}, Dark={StaticResource DarkBg}}">

    <ContentPage.BindingContext>
        <viewmodels:ScheduleTripViewModel />
    </ContentPage.BindingContext>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="25">

                <Label Text="{helpers:Translate Schedule_Section1}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Primary}"/>
                <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource LightDivider}, Dark={StaticResource DarkDivider}}" Margin="0,-15,0,0"/>

                <VerticalStackLayout Spacing="5">
                    <Label Text="{helpers:Translate Schedule_TripType}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource LightTextSub}, Dark={StaticResource DarkTextSub}}"/>
                    <Border Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}">
                        <Picker ItemsSource="{Binding TiposViaje}" SelectedItem="{Binding SelectedTipoViaje}" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"/>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5">
                    <Label Text="{helpers:Translate Schedule_WaypointsTitle}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource LightTextSub}, Dark={StaticResource DarkTextSub}}"/>
                    <Border Stroke="{StaticResource Secondary}" StrokeThickness="1" StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}" Padding="15">
                        <VerticalStackLayout Spacing="10">

                            <Border IsVisible="{Binding HasDestinosFrecuentes}" Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" StrokeShape="RoundRectangle 8" BackgroundColor="Transparent">
                                <Picker Title="{helpers:Translate Schedule_ChooseFrequent}" 
                                        ItemsSource="{Binding DestinosFrecuentes}" 
                                        ItemDisplayBinding="{Binding Alias}" 
                                        SelectedItem="{Binding DestinoFrecuenteSeleccionado}" 
                                        TextColor="{StaticResource Primary}" FontAttributes="Bold"/>
                            </Border>

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding MetasDelViaje}" Spacing="5" IsVisible="{Binding HasMetas}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                                            <Label Grid.Column="0" Text="📍" VerticalOptions="Center"/>
                                            <Label Grid.Column="1" Text="{Binding Alias}" VerticalOptions="Center" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"/>
                                            <ImageButton Grid.Column="2" Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ScheduleTripViewModel}}, Path=EliminarMetaCommand}" CommandParameter="{Binding .}" BackgroundColor="Transparent" HeightRequest="24" WidthRequest="24">
                                                <ImageButton.Source>
                                                    <FontImageSource FontFamily="OpenSansRegular" Glyph="❌" Color="{StaticResource Error}"/>
                                                </ImageButton.Source>
                                            </ImageButton>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <!--  FIX: Botón de mapa adaptado a modo oscuro para que sea visible -->
                            <Button Text="{helpers:Translate Schedule_AddWaypointBtn}" Command="{Binding AbrirMapaMetasCommand}" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#1565C0, Dark=#90CAF9}" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5">
                    <Label Text="{helpers:Translate Schedule_DepartureTime}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource LightTextSub}, Dark={StaticResource DarkTextSub}}"/>
                    <Border Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" StrokeShape="RoundRectangle 8" Padding="15,5" BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}">
                        <TimePicker Time="{Binding HoraSalida}" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}" FontAttributes="Bold"/>
                    </Border>
                </VerticalStackLayout>

                <Border Stroke="{StaticResource Secondary}" StrokeThickness="1" StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}" Padding="15" Margin="0,5">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="{helpers:Translate Schedule_RealWindowHint}" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource LightTextSub}, Dark={StaticResource DarkTextSub}}" FontAttributes="Italic"/>
                        <Grid ColumnDefinitions="*,*">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="{helpers:Translate Schedule_RealStartTime}" FontSize="11" TextColor="{StaticResource Primary}" FontAttributes="Bold"/>
                                <TimePicker Time="{Binding HoraInicioRecorrido}" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}" FontSize="13"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="{helpers:Translate Schedule_RealArrivalTime}" FontSize="11" TextColor="{StaticResource Primary}" FontAttributes="Bold"/>
                                <TimePicker Time="{Binding HoraLlegadaDestino}" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}" FontSize="13"/>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                    <VerticalStackLayout Grid.Column="0" Spacing="5">
                        <Label Text="{helpers:Translate Schedule_StartsOn}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource LightTextSub}, Dark={StaticResource DarkTextSub}}"/>
                        <Border Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" StrokeShape="RoundRectangle 8" Padding="10,0" BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}">
                            <DatePicker Date="{Binding FechaInicio}" Format="dd MMM yyyy" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"/>
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                        <Label Text="{helpers:Translate Schedule_EndsOn}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource LightTextSub}, Dark={StaticResource DarkTextSub}}"/>
                        <Border Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" StrokeShape="RoundRectangle 8" Padding="10,0" BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}">
                            <DatePicker Date="{Binding FechaFin}" Format="dd MMM yyyy" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"/>
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <VerticalStackLayout Spacing="5">
                    <Label Text="{helpers:Translate Schedule_Weekdays}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource LightTextSub}, Dark={StaticResource DarkTextSub}}"/>
                    <FlexLayout Wrap="Wrap" JustifyContent="SpaceBetween">
                        <HorizontalStackLayout>
                            <CheckBox IsChecked="{Binding DiaL}" Color="{StaticResource Primary}"/>
                            <Label Text="{helpers:Translate Day_MonShort}" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout>
                            <CheckBox IsChecked="{Binding DiaM}" Color="{StaticResource Primary}"/>
                            <Label Text="{helpers:Translate Day_TueShort}" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout>
                            <CheckBox IsChecked="{Binding DiaMi}" Color="{StaticResource Primary}"/>
                            <Label Text="{helpers:Translate Day_WedShort}" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout>
                            <CheckBox IsChecked="{Binding DiaJ}" Color="{StaticResource Primary}"/>
                            <Label Text="{helpers:Translate Day_ThuShort}" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout>
                            <CheckBox IsChecked="{Binding DiaV}" Color="{StaticResource Primary}"/>
                            <Label Text="{helpers:Translate Day_FriShort}" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout>
                            <CheckBox IsChecked="{Binding DiaS}" Color="{StaticResource Primary}"/>
                            <Label Text="{helpers:Translate Day_SatShort}" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout>
                            <CheckBox IsChecked="{Binding DiaD}" Color="{StaticResource Primary}"/>
                            <Label Text="{helpers:Translate Day_SunShort}" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </FlexLayout>
                </VerticalStackLayout>

                <Label Text="{helpers:Translate Schedule_Section2}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Primary}" Margin="0,10,0,0"/>
                <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource LightDivider}, Dark={StaticResource DarkDivider}}" Margin="0,-15,0,0"/>

                <VerticalStackLayout Spacing="8">
                    <Label Text="{helpers:Translate Schedule_DriverPicker}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource LightTextSub}, Dark={StaticResource DarkTextSub}}"/>
                    <CollectionView ItemsSource="{Binding ChoferesDisponibles}" SelectionMode="Single" SelectedItem="{Binding SelectedChofer, Mode=TwoWay}" HeightRequest="92">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeShape="RoundRectangle 12" Padding="8" WidthRequest="76"
                                        Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal"/>
                                            <VisualState x:Name="Selected">
                                                <VisualState.Setters>
                                                    <Setter Property="Stroke" Value="{StaticResource Primary}"/>
                                                    <Setter Property="StrokeThickness" Value="3"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                        <Border StrokeShape="RoundRectangle 24" WidthRequest="48" HeightRequest="48" StrokeThickness="0" HorizontalOptions="Center"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}">
                                            <Grid>
                                                <Label Text="👤" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding FotoPerfil, Converter={StaticResource StringToBoolInvertedConverter}}"/>
                                                <Image Source="{Binding FotoPerfil}" Aspect="AspectFill" IsVisible="{Binding FotoPerfil, Converter={StaticResource StringToBoolConverter}}"/>
                                            </Grid>
                                        </Border>
                                        <Label Text="{Binding Nombre}" FontSize="10" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" MaxLines="1" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"/>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="{helpers:Translate Schedule_BusPicker}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource LightTextSub}, Dark={StaticResource DarkTextSub}}"/>
                    <CollectionView ItemsSource="{Binding VehiculosDisponibles}" SelectionMode="Single" SelectedItem="{Binding SelectedVehiculo, Mode=TwoWay}" HeightRequest="92">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeShape="RoundRectangle 12" Padding="8" WidthRequest="76"
                                        Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal"/>
                                            <VisualState x:Name="Selected">
                                                <VisualState.Setters>
                                                    <Setter Property="Stroke" Value="{StaticResource Primary}"/>
                                                    <Setter Property="StrokeThickness" Value="3"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                        <Border StrokeShape="RoundRectangle 8" WidthRequest="48" HeightRequest="48" StrokeThickness="0" HorizontalOptions="Center"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}">
                                            <Grid>
                                                <Label Text="🚐" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding FotoUrl, Converter={StaticResource StringToBoolInvertedConverter}}"/>
                                                <Image Source="{Binding FotoUrl}" Aspect="AspectFill" IsVisible="{Binding FotoUrl, Converter={StaticResource StringToBoolConverter}}"/>
                                            </Grid>
                                        </Border>
                                        <Label Text="{Binding Placa}" FontSize="10" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" MaxLines="1" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"/>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <Button Text="{helpers:Translate Schedule_AddAssignment}" Command="{Binding AddAsignacionCommand}" BackgroundColor="{StaticResource Primary}" TextColor="Black" FontAttributes="Bold" CornerRadius="8" HeightRequest="45"/>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Asignaciones}" Spacing="5">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" StrokeShape="RoundRectangle 8" Padding="10">
                                <Grid ColumnDefinitions="36, 36, *, Auto" ColumnSpacing="8">
                                    <Border Grid.Column="0" StrokeShape="RoundRectangle 18" WidthRequest="36" HeightRequest="36" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}">
                                        <Grid>
                                            <Label Text="👤" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding Chofer.FotoPerfil, Converter={StaticResource StringToBoolInvertedConverter}}"/>
                                            <Image Source="{Binding Chofer.FotoPerfil}" Aspect="AspectFill" IsVisible="{Binding Chofer.FotoPerfil, Converter={StaticResource StringToBoolConverter}}"/>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Column="1" StrokeShape="RoundRectangle 6" WidthRequest="36" HeightRequest="36" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}">
                                        <Grid>
                                            <Label Text="🚐" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding Vehiculo.FotoUrl, Converter={StaticResource StringToBoolInvertedConverter}}"/>
                                            <Image Source="{Binding Vehiculo.FotoUrl}" Aspect="AspectFill" IsVisible="{Binding Vehiculo.FotoUrl, Converter={StaticResource StringToBoolConverter}}"/>
                                        </Grid>
                                    </Border>
                                    <Label Grid.Column="2" Text="{Binding Detalles}" VerticalOptions="Center" FontAttributes="Bold"/>
                                    <ImageButton Grid.Column="3" Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ScheduleTripViewModel}}, Path=RemoveAsignacionCommand}" CommandParameter="{Binding .}" WidthRequest="25" HeightRequest="25" BackgroundColor="Transparent">
                                        <ImageButton.Source>
                                            <FontImageSource FontFamily="OpenSansRegular" Glyph="❌" Color="{StaticResource Error}"/>
                                        </ImageButton.Source>
                                    </ImageButton>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Button Text="{helpers:Translate Schedule_PublishTrips}" Command="{Binding SaveTripCommand}" BackgroundColor="{StaticResource Primary}" TextColor="Black" FontAttributes="Bold" CornerRadius="8" HeightRequest="50" Margin="0,20,0,0"/>
            </VerticalStackLayout>
        </ScrollView>

        <Grid IsVisible="{Binding IsMapModalVisible}" BackgroundColor="{AppThemeBinding Light={StaticResource LightBg}, Dark={StaticResource DarkBg}}" RowDefinitions="Auto, *, Auto">
            <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Padding="15" BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}">
                <ImageButton Grid.Column="0" Command="{Binding CerrarMapaCommand}" BackgroundColor="Transparent" WidthRequest="40" HeightRequest="40">
                    <ImageButton.Source>
                        <FontImageSource FontFamily="OpenSansRegular" Glyph="⬅️" Color="{AppThemeBinding Light=#1565C0, Dark=#90CAF9}"/>
                    </ImageButton.Source>
                </ImageButton>
                <Label Grid.Column="1" Text="{helpers:Translate Schedule_MapModalTitle}" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1565C0, Dark=#90CAF9}" VerticalOptions="Center"/>
            </Grid>

            <Grid Grid.Row="1" RowDefinitions="Auto, *">
                <Border Grid.Row="0" Margin="15,10" Stroke="{StaticResource Primary}" StrokeShape="RoundRectangle 25" BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}">
                    <SearchBar x:Name="BuscadorMetas" Placeholder="{helpers:Translate Schedule_MapSearchPlaceholder}" SearchButtonPressed="BuscadorMetas_SearchButtonPressed" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"/>
                </Border>
                <maps:Map x:Name="MapaDestinosOficial" Grid.Row="1" MapType="{Binding CurrentMapType}" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" IsShowingUser="True" />
                <Label Grid.Row="1" Text="🎯" FontSize="40" HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True"/>
                <Button Grid.Row="1" Text="🛰️" Command="{Binding ToggleMapTypeCommand}" HorizontalOptions="End" VerticalOptions="Start" Margin="0,10,10,0" WidthRequest="44" HeightRequest="44" CornerRadius="22" Padding="0" BackgroundColor="#CC000000" FontSize="20"/>
            </Grid>

            <VerticalStackLayout Grid.Row="2" Padding="20" Spacing="15" BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}">
                <Label Text="{helpers:Translate Schedule_MapAliasPrompt}" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"/>
                <Border Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" StrokeShape="RoundRectangle 8" Padding="10,0">
                    <Entry Text="{Binding NuevoAliasPunto}" Placeholder="{helpers:Translate Schedule_MapAliasPlaceholder}" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}" />
                </Border>
                <!-- FIX: Botón con contraste seguro en negro sobre primary -->
                <Button Text="{helpers:Translate Schedule_MapConfirmBtn}" Command="{Binding ConfirmarPuntoMapaCommand}" BackgroundColor="{StaticResource Primary}" TextColor="Black" FontAttributes="Bold" HeightRequest="50" CornerRadius="8"/>
            </VerticalStackLayout>
        </Grid>

        <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Color="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="50" HeightRequest="50"/>
    </Grid>
</ContentPage>