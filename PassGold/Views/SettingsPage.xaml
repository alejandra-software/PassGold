<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:PassGold.Helpers"
             x:Class="PassGold.Views.SettingsPage"
             xmlns:viewmodels="clr-namespace:PassGold.ViewModels"
             Title="{helpers:Translate SettingsPageTitle}"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightBg}, Dark={StaticResource DarkBg}}">

    <ContentPage.BindingContext>
        <viewmodels:SettingsViewModel />
    </ContentPage.BindingContext>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="25">

                <!-- ============================================== -->
                <!-- TARJETA DE PERFIL DETALLADA -->
                <!-- ============================================== -->
                <Border Stroke="{StaticResource Primary}" BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}" StrokeThickness="2" StrokeShape="RoundRectangle 12" Padding="20">
                    <VerticalStackLayout Spacing="15">

                        <!-- Vista normal (no editando) -->
                        <VerticalStackLayout Spacing="12" IsVisible="{Binding IsEditingProfile, Converter={StaticResource InvertedBoolConverter}}">
                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="15">
                                <Border Grid.Column="0" WidthRequest="70" HeightRequest="70" StrokeShape="RoundRectangle 35" StrokeThickness="0" BackgroundColor="{StaticResource Primary}" VerticalOptions="Center" Padding="0">
                                    <Grid>
                                        <Image Source="{Binding UserPhotoUrl}" Aspect="AspectFill" IsVisible="{Binding HasUserPhoto}"/>
                                        <Label Text="👤" FontSize="35" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding HasUserPhoto, Converter={StaticResource InvertedBoolConverter}}"/>
                                    </Grid>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="FotoPerfil_Tapped" />
                                    </Border.GestureRecognizers>
                                </Border>

                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding UserName}" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"/>
                                    <Label Text="{Binding UserRole}" FontSize="12" TextColor="{StaticResource Primary}" TextTransform="Uppercase" FontAttributes="Bold"/>
                                </VerticalStackLayout>

                                <Button Grid.Column="2" Text="{helpers:Translate SettingsProfile_EditBtn}" FontSize="13" BackgroundColor="{AppThemeBinding Light={StaticResource LightButtonSec}, Dark={StaticResource DarkButtonSec}}" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}" Command="{Binding ToggleEditProfileCommand}" VerticalOptions="Center" CornerRadius="8" Padding="12,6"/>
                            </Grid>

                            <!-- Datos de contacto detallados -->
                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource LightDivider}, Dark={StaticResource DarkDivider}}" Margin="0,5"/>
                            <VerticalStackLayout Spacing="6">
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="✉️" FontSize="14" VerticalOptions="Center"/>
                                    <Label Text="{Binding UserEmail}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource LightTextSub}, Dark={StaticResource DarkTextSub}}" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="📞" FontSize="14" VerticalOptions="Center"/>
                                    <Label Text="{Binding UserPhone}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource LightTextSub}, Dark={StaticResource DarkTextSub}}" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <!-- Modo edición -->
                        <VerticalStackLayout Spacing="12" IsVisible="{Binding IsEditingProfile}">
                            <Border WidthRequest="80" HeightRequest="80" StrokeShape="RoundRectangle 40" StrokeThickness="0" BackgroundColor="{StaticResource Primary}" HorizontalOptions="Center" Padding="0">
                                <Grid>
                                    <Image Source="{Binding EditableFotoUrl}" Aspect="AspectFill" IsVisible="{Binding HasEditableFoto}"/>
                                    <Label Text="👤" FontSize="40" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding HasEditableFoto, Converter={StaticResource InvertedBoolConverter}}"/>
                                </Grid>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="FotoPerfilEditable_Tapped" />
                                </Border.GestureRecognizers>
                            </Border>

                            <Button Text="{helpers:Translate SettingsProfile_ChangePhotoBtn}"
                                    Command="{Binding PickProfilePhotoCommand}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource LightButtonSec}, Dark={StaticResource DarkButtonSec}}"
                                    TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"
                                    FontSize="13" CornerRadius="8" HorizontalOptions="Center"
                                    IsEnabled="{Binding IsUploadingPhoto, Converter={StaticResource InvertedBoolConverter}}"/>
                            <ActivityIndicator IsRunning="{Binding IsUploadingPhoto}" IsVisible="{Binding IsUploadingPhoto}" Color="{StaticResource Primary}"/>

                            <Label Text="{helpers:Translate SettingsProfile_NameLabel}" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"/>
                            <Border Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" StrokeShape="RoundRectangle 8" Padding="10,0">
                                <Entry Text="{Binding EditableNombre}" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"/>
                            </Border>

                            <Label Text="{helpers:Translate SettingsProfile_PhoneLabel}" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"/>
                            <Border Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" StrokeShape="RoundRectangle 8" Padding="10,0">
                                <Entry Text="{Binding EditableTelefono}" Keyboard="Telephone" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"/>
                            </Border>

                            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" Margin="0,8,0,0">
                                <Button Text="{helpers:Translate SettingsProfile_SaveBtn}"
                                        Command="{Binding SaveProfileCommand}"
                                        BackgroundColor="{StaticResource Primary}" TextColor="#000000" FontAttributes="Bold" CornerRadius="8"
                                        IsEnabled="{Binding IsSavingProfile, Converter={StaticResource InvertedBoolConverter}}"/>
                                <Button Text="{helpers:Translate SettingsProfile_CancelBtn}"
                                        Command="{Binding ToggleEditProfileCommand}"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource LightButtonSec}, Dark={StaticResource DarkButtonSec}}"
                                        TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"
                                        CornerRadius="8"/>
                            </HorizontalStackLayout>
                            <ActivityIndicator IsRunning="{Binding IsSavingProfile}" IsVisible="{Binding IsSavingProfile}" Color="{StaticResource Primary}"/>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <!-- ============================================== -->
                <!-- 🆕 MI ROL (todos): pasajero, independiente, jefe, empleado -->
                <!-- ============================================== -->
                <Border Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" StrokeShape="RoundRectangle 12" Padding="15" BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}">
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                            <Label Text="{helpers:Translate Role_SectionTitle}" FontAttributes="Bold" FontSize="15" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"/>
                            <Label Text="{Binding UserRole}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Primary}"/>
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="{helpers:Translate Role_ChangeBtn}" Command="{Binding CambiarRolCommand}" FontSize="13" BackgroundColor="{AppThemeBinding Light={StaticResource LightButtonSec}, Dark={StaticResource DarkButtonSec}}" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}" CornerRadius="8" Padding="12,6" VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- ============================================== -->
                <!-- SECCIÓN EMPLEADO: VINCULARSE A FLOTA -->
                <!-- ============================================== -->
                <VerticalStackLayout Spacing="10" IsVisible="{Binding IsEmployee}">
                    <Label Text="{helpers:Translate SettingsMyFleetTitle}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Primary}"/>

                    <VerticalStackLayout Spacing="10" IsVisible="{Binding HasBoss, Converter={StaticResource InvertedBoolConverter}}">
                        <Label Text="{helpers:Translate SettingsPasteDesc}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource LightTextSub}, Dark={StaticResource DarkTextSub}}"/>
                        <Border Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" StrokeShape="RoundRectangle 8" Padding="10,0">
                            <Entry Text="{Binding InputFleetCode}" Placeholder="{helpers:Translate SettingsInputPlaceholder}" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}" />
                        </Border>
                        <Button Text="{helpers:Translate SettingsJoinBtn}" Command="{Binding JoinFleetCommand}" BackgroundColor="{StaticResource Primary}" TextColor="#000000" FontAttributes="Bold" CornerRadius="8" HeightRequest="45"/>
                    </VerticalStackLayout>

                    <!-- Si YA tiene jefe -->
                    <Border IsVisible="{Binding HasBoss}" Stroke="{StaticResource Primary}" StrokeShape="RoundRectangle 8" Padding="15" BackgroundColor="{AppThemeBinding Light={StaticResource LightButtonSec}, Dark={StaticResource DarkButtonSec}}">
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="✅" FontSize="20" VerticalOptions="Center"/>
                            <Label Text="{helpers:Translate SettingsWorkingFor}" FontAttributes="Bold" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource LightTextSub}, Dark={StaticResource DarkTextSub}}"/>
                            <Label Text="{Binding CurrentBossName}" FontAttributes="Bold" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"/>
                        </HorizontalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ============================================== -->
                <!-- CHOFER / JEFE: COMPARTIR MI UBICACIÓN -->
                <!-- 🔧 Antes este interruptor guardaba una preferencia que ningún código leía.
                     Ahora está conectado: al encenderlo se pide el permiso de ubicación AQUÍ
                     (con el carro parado) y el rastreo del viaje lo respeta. -->
                <!-- ============================================== -->
                <Border IsVisible="{Binding IsPassenger, Converter={StaticResource InvertedBoolConverter}}" Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" StrokeShape="RoundRectangle 12" Padding="15" BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15">
                        <Switch Grid.Column="0" IsToggled="{Binding CompartirUbicacion}" OnColor="{StaticResource Primary}" VerticalOptions="Center"/>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="{Binding TxtCompartirTitulo}" FontAttributes="Bold" FontSize="15" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"/>
                            <Label Text="{Binding TxtCompartirDesc}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource LightTextSub}, Dark={StaticResource DarkTextSub}}"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- ============================================== -->
                <!-- PASAJERO: AVISARME CUANDO MI CHOFER ESTÉ CERCA -->
                <!-- 🔧 Antes el interruptor era un IsToggled="True" fijo, sin conexión. -->
                <!-- ============================================== -->
                <Border IsVisible="{Binding IsPassenger}" Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" StrokeShape="RoundRectangle 12" Padding="15" BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15">
                            <Switch Grid.Column="0" IsToggled="{Binding AvisosCercania}" OnColor="{StaticResource Primary}" VerticalOptions="Center"/>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding TxtAvisosTitulo}" FontAttributes="Bold" FontSize="15" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"/>
                                <Label Text="{Binding TxtAvisosDesc}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource LightTextSub}, Dark={StaticResource DarkTextSub}}"/>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- A cuántos metros quiere el aviso (solo si los avisos están encendidos) -->
                        <VerticalStackLayout Spacing="6" IsVisible="{Binding AvisosCercania}">
                            <Label Text="{Binding TxtDistanciaAviso}" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"/>
                            <Border Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" StrokeShape="RoundRectangle 8" Padding="10,0">
                                <Picker ItemsSource="{Binding OpcionesDistancia}" SelectedIndex="{Binding DistanciaIndex}" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}" BackgroundColor="Transparent"/>
                            </Border>
                            <Label Text="{Binding TxtDistanciaAyuda}" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource LightTextSub}, Dark={StaticResource DarkTextSub}}"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ============================================== -->
                <!-- 🆕 APARIENCIA E IDIOMA (todos los roles) — automáticos por defecto -->
                <!-- ============================================== -->
                <Border Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" StrokeShape="RoundRectangle 12" Padding="15" BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding TxtApariencia}" FontAttributes="Bold" FontSize="15" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"/>

                        <Label Text="{Binding TxtTema}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource LightTextSub}, Dark={StaticResource DarkTextSub}}"/>
                        <Border Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" StrokeShape="RoundRectangle 8" Padding="10,0">
                            <Picker ItemsSource="{Binding OpcionesTema}" SelectedIndex="{Binding TemaIndex}" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}" BackgroundColor="Transparent"/>
                        </Border>

                        <Label Text="{Binding TxtIdioma}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource LightTextSub}, Dark={StaticResource DarkTextSub}}"/>
                        <Border Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" StrokeShape="RoundRectangle 8" Padding="10,0">
                            <Picker ItemsSource="{Binding OpcionesIdioma}" SelectedIndex="{Binding IdiomaIndex}" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}" BackgroundColor="Transparent"/>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- ============================================== -->
                <!-- 🆕 PRIVACIDAD Y CUENTA (todos los roles) -->
                <!-- ============================================== -->
                <Border Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" StrokeShape="RoundRectangle 12" Padding="15" BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{helpers:Translate Settings_LegalTitle}" FontAttributes="Bold" FontSize="15" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"/>
                        <Button Text="{helpers:Translate Settings_PrivacyBtn}" Command="{Binding AbrirPrivacidadCommand}" BackgroundColor="{AppThemeBinding Light={StaticResource LightButtonSec}, Dark={StaticResource DarkButtonSec}}" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}" CornerRadius="8" HeightRequest="44"/>
                        <Button Text="{helpers:Translate Settings_TermsBtn}" Command="{Binding AbrirTerminosCommand}" BackgroundColor="{AppThemeBinding Light={StaticResource LightButtonSec}, Dark={StaticResource DarkButtonSec}}" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}" CornerRadius="8" HeightRequest="44"/>
                    </VerticalStackLayout>
                </Border>

                <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource LightDivider}, Dark={StaticResource DarkDivider}}" Margin="0,10"/>

                <!-- CERRAR SESIÓN -->
                <Button Text="{helpers:Translate SettingsLogoutBtn}" Command="{Binding LogoutCommand}" BackgroundColor="{StaticResource Error}" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="50"/>

                <!-- 🆕 ELIMINAR MI CUENTA (Google Play lo exige dentro de la app) -->
                <Button Text="{helpers:Translate Settings_DeleteAccountBtn}" Command="{Binding EliminarCuentaCommand}" BackgroundColor="Transparent" BorderColor="{StaticResource Error}" BorderWidth="1" TextColor="{StaticResource Error}" CornerRadius="8" HeightRequest="46" Margin="0,0,0,20"
                        IsEnabled="{Binding IsDeletingAccount, Converter={StaticResource InvertedBoolConverter}}"/>

            </VerticalStackLayout>
        </ScrollView>

        <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Color="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="50" HeightRequest="50"/>
    </Grid>
</ContentPage>