<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:PassGold.Helpers"
             x:Class="PassGold.Views.FleetSchedulePage"
             Title="{Binding TituloAgenda}"
             BackgroundColor="{AppThemeBinding Light=#F5F7FA, Dark=#121212}">

    <!-- REDISEÑO: como los horarios que los choferes publican en WhatsApp.
         - Una tira de días de las próximas 5 semanas (sin cambiar de semana con flechas).
         - Por día, dos columnas: "Llegar a la U" y "Salir de la U".
         - Si a una hora salen varios micros, al tocarla se despliegan para elegir chofer. -->
    <Grid RowDefinitions="Auto, Auto, *, Auto">

        <!-- ENCABEZADO -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Padding="16,12,12,4" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}">
            <VerticalStackLayout Grid.Column="0" Spacing="2">
                <Label Text="{helpers:Translate FleetSched_Title}" FontAttributes="Bold" FontSize="16" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                <Label Text="{helpers:Translate FleetSched_Subtitle}" FontSize="12" TextColor="Gray"/>
            </VerticalStackLayout>
            <!-- 🆕 Alternar entre la vista por día y la vista tipo horario de la universidad -->
            <Button Grid.Column="1" Text="{Binding TextoBotonVista}" Command="{Binding CambiarVistaCommand}" VerticalOptions="Center"
                    FontSize="12" Padding="10,0" HeightRequest="36" CornerRadius="18"
                    BackgroundColor="Transparent" BorderColor="{StaticResource Primary}" BorderWidth="1" TextColor="{StaticResource Primary}"/>
        </Grid>

        <!-- TIRA DE DÍAS (deslizar a la derecha para ver más semanas) -->
        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}" IsVisible="{Binding VistaPorDia}">
            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Dias}" Spacing="6" Padding="10,6,10,10">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Mes}" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Primary}" HeightRequest="15"/>
                            <Border WidthRequest="50" HeightRequest="64" StrokeShape="RoundRectangle 12" StrokeThickness="0"
                                    BackgroundColor="{Binding ColorFondo}" Opacity="{Binding Opacidad}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ElegirCommand}" CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                                <VerticalStackLayout VerticalOptions="Center" Spacing="0">
                                    <Label Text="{Binding Abrev}" FontSize="12" HorizontalOptions="Center" TextColor="{Binding ColorTexto}"/>
                                    <Label Text="{Binding Numero}" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{Binding ColorTexto}"/>
                                    <Label Text="{Binding TextoHoy}" FontSize="9" HorizontalOptions="Center" TextColor="{Binding ColorTexto}"/>
                                    <Label Text="•" FontSize="14" HorizontalOptions="Center" Margin="0,-6,0,0" TextColor="{StaticResource Primary}" IsVisible="{Binding TieneSeleccion}"/>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- LLEGADAS / SALIDAS DEL DÍA ELEGIDO -->
        <ScrollView Grid.Row="2" IsVisible="{Binding VistaPorDia}">
            <VerticalStackLayout Padding="12,10" Spacing="10">

                <Label Text="{Binding TituloDiaActivo}" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>

                <Label Text="{Binding MensajeSinViajes}" FontSize="14" HorizontalTextAlignment="Center" Margin="10,30" TextColor="Gray"
                       IsVisible="{Binding DiaActivo.SinViajes}"/>

                <Grid ColumnDefinitions="*, *" ColumnSpacing="10" IsVisible="{Binding DiaActivo.SinViajes, Converter={StaticResource InvertedBoolConverter}}">

                    <!-- LLEGAR A LA U (ida) -->
                    <VerticalStackLayout Grid.Column="0" Spacing="8">
                        <Border BackgroundColor="#2E7D32" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="8,8">
                            <Label Text="{helpers:Translate FleetSched_ArriveHeader}" FontAttributes="Bold" FontSize="14" TextColor="White" HorizontalOptions="Center"/>
                        </Border>
                        <Label Text="{helpers:Translate FleetSched_NoArrivals}" FontSize="12" TextColor="Gray" HorizontalOptions="Center" IsVisible="{Binding DiaActivo.SinLlegadas}"/>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding DiaActivo.Llegadas}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border StrokeShape="RoundRectangle 12" StrokeThickness="2" Padding="10,8"
                                            BackgroundColor="{Binding ColorFondo}" Stroke="{Binding ColorBorde}" Opacity="{Binding Opacidad}">
                                        <VerticalStackLayout Spacing="6">
                                            <Grid ColumnDefinitions="*, Auto">
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding TocarCommand}" CommandParameter="{Binding .}"/>
                                                </Grid.GestureRecognizers>
                                                <VerticalStackLayout Grid.Column="0" Spacing="1">
                                                    <Label Text="{Binding Hora}" FontSize="17" FontAttributes="Bold" TextColor="{Binding ColorTexto}"/>
                                                    <Label Text="{Binding Detalle}" FontSize="11" TextColor="{Binding ColorTexto}" Opacity="0.75" LineBreakMode="WordWrap"/>
                                                    <Label Text="{Binding TextoChofer}" FontSize="11" FontAttributes="Bold" TextColor="{Binding ColorTexto}" LineBreakMode="WordWrap"/>
                                                </VerticalStackLayout>
                                                <Label Grid.Column="1" Text="{Binding Marca}" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" TextColor="{Binding ColorTexto}"/>
                                            </Grid>
                                            <!-- Elegir chofer cuando salen varios micros -->
                                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Unidades}" Spacing="4" IsVisible="{Binding MostrarUnidades}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#99000000" Padding="6" BackgroundColor="{Binding ColorFondo}">
                                                            <Border.GestureRecognizers>
                                                                <TapGestureRecognizer Command="{Binding ElegirCommand}" CommandParameter="{Binding .}"/>
                                                            </Border.GestureRecognizers>
                                                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="6">
                                                                <Border Grid.Column="0" WidthRequest="28" HeightRequest="28" StrokeShape="RoundRectangle 14" StrokeThickness="0" BackgroundColor="#33000000" VerticalOptions="Center">
                                                                    <Grid>
                                                                        <Label Text="👤" FontSize="13" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding TieneFoto, Converter={StaticResource InvertedBoolConverter}}"/>
                                                                        <Image Source="{Binding Foto}" Aspect="AspectFill" IsVisible="{Binding TieneFoto}"/>
                                                                    </Grid>
                                                                </Border>
                                                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                                                                    <Label Text="{Binding Nombre}" FontSize="12" FontAttributes="Bold" TextColor="Black" LineBreakMode="TailTruncation"/>
                                                                    <Label Text="{Binding Detalle}" FontSize="10" TextColor="#333333" LineBreakMode="TailTruncation"/>
                                                                </VerticalStackLayout>
                                                                <Label Grid.Column="2" Text="{Binding Marca}" FontSize="16" TextColor="Black" VerticalOptions="Center"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- SALIR DE LA U (regreso) -->
                    <VerticalStackLayout Grid.Column="1" Spacing="8">
                        <Border BackgroundColor="#1565C0" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="8,8">
                            <Label Text="{helpers:Translate FleetSched_LeaveHeader}" FontAttributes="Bold" FontSize="14" TextColor="White" HorizontalOptions="Center"/>
                        </Border>
                        <Label Text="{helpers:Translate FleetSched_NoDepartures}" FontSize="12" TextColor="Gray" HorizontalOptions="Center" IsVisible="{Binding DiaActivo.SinSalidas}"/>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding DiaActivo.Salidas}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border StrokeShape="RoundRectangle 12" StrokeThickness="2" Padding="10,8"
                                            BackgroundColor="{Binding ColorFondo}" Stroke="{Binding ColorBorde}" Opacity="{Binding Opacidad}">
                                        <VerticalStackLayout Spacing="6">
                                            <Grid ColumnDefinitions="*, Auto">
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding TocarCommand}" CommandParameter="{Binding .}"/>
                                                </Grid.GestureRecognizers>
                                                <VerticalStackLayout Grid.Column="0" Spacing="1">
                                                    <Label Text="{Binding Hora}" FontSize="17" FontAttributes="Bold" TextColor="{Binding ColorTexto}"/>
                                                    <Label Text="{Binding Detalle}" FontSize="11" TextColor="{Binding ColorTexto}" Opacity="0.75" LineBreakMode="WordWrap"/>
                                                    <Label Text="{Binding TextoChofer}" FontSize="11" FontAttributes="Bold" TextColor="{Binding ColorTexto}" LineBreakMode="WordWrap"/>
                                                </VerticalStackLayout>
                                                <Label Grid.Column="1" Text="{Binding Marca}" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" TextColor="{Binding ColorTexto}"/>
                                            </Grid>
                                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Unidades}" Spacing="4" IsVisible="{Binding MostrarUnidades}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#99000000" Padding="6" BackgroundColor="{Binding ColorFondo}">
                                                            <Border.GestureRecognizers>
                                                                <TapGestureRecognizer Command="{Binding ElegirCommand}" CommandParameter="{Binding .}"/>
                                                            </Border.GestureRecognizers>
                                                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="6">
                                                                <Border Grid.Column="0" WidthRequest="28" HeightRequest="28" StrokeShape="RoundRectangle 14" StrokeThickness="0" BackgroundColor="#33000000" VerticalOptions="Center">
                                                                    <Grid>
                                                                        <Label Text="👤" FontSize="13" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding TieneFoto, Converter={StaticResource InvertedBoolConverter}}"/>
                                                                        <Image Source="{Binding Foto}" Aspect="AspectFill" IsVisible="{Binding TieneFoto}"/>
                                                                    </Grid>
                                                                </Border>
                                                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                                                                    <Label Text="{Binding Nombre}" FontSize="12" FontAttributes="Bold" TextColor="Black" LineBreakMode="TailTruncation"/>
                                                                    <Label Text="{Binding Detalle}" FontSize="10" TextColor="#333333" LineBreakMode="TailTruncation"/>
                                                                </VerticalStackLayout>
                                                                <Label Grid.Column="2" Text="{Binding Marca}" FontSize="16" TextColor="Black" VerticalOptions="Center"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Grid>

                <Label Text="{helpers:Translate FleetSched_DayHint}"
                       FontSize="11" TextColor="Gray" HorizontalTextAlignment="Center" Margin="0,10,0,0"/>
            </VerticalStackLayout>
        </ScrollView>

        <!-- ═════════ 🆕 VISTA "📅 HORARIO" (como el de la universidad) ═════════ -->
        <Grid Grid.Row="1" Grid.RowSpan="2" RowDefinitions="Auto, *" IsVisible="{Binding VistaHorario}">

            <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Padding="6,6" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}">
                <Button Grid.Column="0" Text="◀" Command="{Binding SemanaHorarioAnteriorCommand}" IsEnabled="{Binding PuedeSemanaAnterior}"
                        BackgroundColor="Transparent" TextColor="{StaticResource Primary}" FontSize="20" WidthRequest="48"/>
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" Spacing="1">
                    <Label Text="{Binding TextoSemanaHorario}" FontAttributes="Bold" FontSize="14" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                    <Label Text="{helpers:Translate FleetSched_Legend}" FontSize="11" TextColor="Gray" HorizontalOptions="Center"/>
                </VerticalStackLayout>
                <Button Grid.Column="2" Text="▶" Command="{Binding SemanaHorarioSiguienteCommand}" IsEnabled="{Binding PuedeSemanaSiguiente}"
                        BackgroundColor="Transparent" TextColor="{StaticResource Primary}" FontSize="20" WidthRequest="48"/>
            </Grid>

            <ScrollView Grid.Row="1" Orientation="Both">
                <VerticalStackLayout Padding="8,6,8,16" Spacing="0">

                    <!-- Encabezado: días -->
                    <HorizontalStackLayout Spacing="4" Margin="0,0,0,4">
                        <Border WidthRequest="62" HeightRequest="42" BackgroundColor="#7B1E1E" StrokeThickness="0" StrokeShape="RoundRectangle 6">
                            <Label Text="{helpers:Translate FleetSched_TimeHeader}" TextColor="White" FontAttributes="Bold" FontSize="12" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <HorizontalStackLayout BindableLayout.ItemsSource="{Binding ColumnasHorario}" Spacing="4">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border WidthRequest="64" HeightRequest="42" BackgroundColor="#7B1E1E" StrokeThickness="0" StrokeShape="RoundRectangle 6" Opacity="{Binding Opacidad}">
                                        <VerticalStackLayout VerticalOptions="Center" Spacing="0">
                                            <Label Text="{Binding Abrev}" TextColor="White" FontAttributes="Bold" FontSize="12" HorizontalOptions="Center"/>
                                            <Label Text="{Binding Numero}" TextColor="White" FontSize="12" HorizontalOptions="Center"/>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </HorizontalStackLayout>

                    <Label Text="{helpers:Translate FleetSched_NoTripsWeek}" FontSize="14" TextColor="Gray" Margin="10,30" IsVisible="{Binding HorarioVacio}"/>

                    <!-- Filas: una por hora -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding FilasHorario}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <HorizontalStackLayout Spacing="4" Padding="0,3" BackgroundColor="{Binding ColorFondo}">
                                    <Label Text="{Binding Hora}" WidthRequest="62" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" HorizontalTextAlignment="Center"
                                           TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                                    <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Celdas}" Spacing="4">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <VerticalStackLayout WidthRequest="64" MinimumHeightRequest="38" Spacing="3" VerticalOptions="Center" BindableLayout.ItemsSource="{Binding Chips}">
                                                    <BindableLayout.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border HeightRequest="36" StrokeShape="RoundRectangle 8" StrokeThickness="2"
                                                                    BackgroundColor="{Binding ColorFondo}" Stroke="{Binding ColorBorde}" Opacity="{Binding Opacidad}">
                                                                <Border.GestureRecognizers>
                                                                    <TapGestureRecognizer Command="{Binding TocarEnHorarioCommand}" CommandParameter="{Binding .}"/>
                                                                </Border.GestureRecognizers>
                                                                <Label Text="{Binding TextoCompacto}" FontSize="13" FontAttributes="Bold" TextColor="{Binding ColorTexto}"
                                                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </BindableLayout.ItemTemplate>
                                                </VerticalStackLayout>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </HorizontalStackLayout>
                                </HorizontalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Label Text="{helpers:Translate FleetSched_GridHint}"
                           FontSize="11" TextColor="Gray" Margin="0,12,0,0" WidthRequest="330" HorizontalOptions="Start"/>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <!-- CONTINUAR (solo pasajeros) -->
        <Border Grid.Row="3" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}" Padding="15,10,15,20" StrokeThickness="0" IsVisible="{Binding IsPasajero}">
            <Button Text="{Binding TextoBotonContinuar}" Command="{Binding IrAConfirmarReservaCommand}" IsEnabled="{Binding HaySeleccion}"
                    BackgroundColor="{StaticResource Primary}" TextColor="Black" FontAttributes="Bold" HeightRequest="52" CornerRadius="10"/>
        </Border>

        <ActivityIndicator Grid.RowSpan="4" IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Color="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="50" HeightRequest="50"/>
    </Grid>
</ContentPage>
