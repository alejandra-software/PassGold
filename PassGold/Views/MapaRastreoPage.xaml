<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:PassGold.Helpers"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             x:Class="PassGold.Views.MapaRastreoPage"
             xmlns:viewmodels="clr-namespace:PassGold.ViewModels"
             Title="{helpers:Translate Track_Title}"
             Shell.NavBarIsVisible="True"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightBg}, Dark={StaticResource DarkBg}}">

    <ContentPage.BindingContext>
        <viewmodels:MapaRastreoViewModel />
    </ContentPage.BindingContext>

    <Grid>
        <!-- ESTADO 1: NO HAY VIAJE EN CURSO -->
        <VerticalStackLayout IsVisible="{Binding HasViajeActivo, Converter={StaticResource InvertedBoolConverter}}"
                             HorizontalOptions="Center" VerticalOptions="Center" Spacing="20">
            <Label Text="📍" FontSize="60" HorizontalOptions="Center"/>
            <Label Text="{helpers:Translate Track_NoTrips}" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"/>
            <Label Text="{helpers:Translate Track_NoTripsDesc}"
                   FontSize="14" HorizontalTextAlignment="Center" Margin="30,0" TextColor="{AppThemeBinding Light={StaticResource LightHint}, Dark={StaticResource DarkHint}}"/>
        </VerticalStackLayout>

        <!-- ESTADO 2: MAPA ACTIVO -->
        <Grid IsVisible="{Binding HasViajeActivo}" RowDefinitions="*, Auto">

            <!-- Sin IsShowingUser: en esta pantalla no se pide el permiso de ubicación y el
                 pasajero no necesita verse a sí mismo — lo que importa es dónde viene su chofer. -->
            <maps:Map Grid.Row="0" x:Name="MapaChofer" MapType="Street" />
            <!-- 🛰️ Cambia entre mapa normal y satélite (para reconocer el lugar) -->
            <Button Text="🛰️" Clicked="CambiarTipoMapa_Clicked" HorizontalOptions="Start" VerticalOptions="Start" Margin="10" WidthRequest="44" HeightRequest="44" CornerRadius="22" Padding="0" BackgroundColor="#CC000000" TextColor="White" FontSize="20"/>

            <!-- Tarjeta inferior -->
            <Border Grid.Row="1" BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}"
                    StrokeThickness="0" StrokeShape="RoundRectangle 20,20,0,0" Padding="20">
                <Grid ColumnDefinitions="Auto, *">
                    <Border Grid.Column="0" WidthRequest="50" HeightRequest="50" StrokeShape="RoundRectangle 25" StrokeThickness="0" BackgroundColor="{StaticResource Primary}" Margin="0,0,15,0">
                        <Label Text="🚐" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Text="{helpers:Translate Track_UnitOnTheWay}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Primary}"/>
                        <Label Text="{Binding ChoferNombre}" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"/>
                        <Label Text="{Binding EstadoTexto}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource LightHint}, Dark={StaticResource DarkHint}}"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

        </Grid>

        <!-- Indicador de Carga -->
        <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Color="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center"/>
    </Grid>
</ContentPage>
