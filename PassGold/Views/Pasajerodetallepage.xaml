<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:PassGold.Helpers"
             x:Class="PassGold.Views.PasajeroDetallePage"
             BackgroundColor="#80000000">

    <Grid HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="320">
        <Border StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}" StrokeShape="RoundRectangle 20" Padding="20">
            <VerticalStackLayout Spacing="15">

                <!-- Foto Grande del Pasajero -->
                <Border WidthRequest="120" HeightRequest="120" StrokeShape="RoundRectangle 60" HorizontalOptions="Center" StrokeThickness="3" Stroke="{StaticResource Primary}" BackgroundColor="#E0E0E0">
                    <Grid>
                        <Label Text="🎓" HorizontalOptions="Center" VerticalOptions="Center" FontSize="40" IsVisible="{Binding FotoUrl, Converter={StaticResource StringToBoolInvertedConverter}}"/>
                        <Image Source="{Binding FotoUrl}" Aspect="AspectFill" IsVisible="{Binding FotoUrl, Converter={StaticResource StringToBoolConverter}}"/>
                    </Grid>
                </Border>

                <!-- Nombre y Rol -->
                <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                    <Label Text="{Binding Nombre}" FontSize="20" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"/>
                    <Label Text="{helpers:Translate RegisterStep2RolePassenger}" FontSize="12" TextColor="Gray" HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>

                <BoxView HeightRequest="1" Color="#33808080" Margin="0,5"/>

                <!-- Dirección de Recogida -->
                <VerticalStackLayout Spacing="2">
                    <Label Text="{helpers:Translate PassengerDetail_Pickup}" FontSize="12" TextColor="Gray" FontAttributes="Bold"/>
                    <Label Text="{Binding Ubicacion}" FontSize="14" TextColor="{AppThemeBinding Light=#333333, Dark=#CCCCCC}"/>
                </VerticalStackLayout>

                <!-- Teléfono -->
                <VerticalStackLayout Spacing="2">
                    <Label Text="{helpers:Translate SettingsProfile_PhoneLabel}" FontSize="12" TextColor="Gray" FontAttributes="Bold"/>
                    <Label Text="{Binding Telefono}" FontSize="14" TextColor="{AppThemeBinding Light=#333333, Dark=#CCCCCC}"/>
                </VerticalStackLayout>

                <!-- Botón Cerrar -->
                <Button Text="{helpers:Translate SettingsJoinErrorClose}" Clicked="Cerrar_Clicked" BackgroundColor="{StaticResource Primary}" TextColor="Black" FontAttributes="Bold" CornerRadius="10" Margin="0,10,0,0"/>

            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>