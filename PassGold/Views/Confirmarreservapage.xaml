<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             xmlns:helpers="clr-namespace:PassGold.Helpers"
             xmlns:vm="clr-namespace:PassGold.ViewModels"
             x:Class="PassGold.Views.ConfirmarReservaPage"
             Title="{helpers:Translate ConfirmarReserva_Title}"
             BackgroundColor="{AppThemeBinding Light=#F5F7FA, Dark=#121212}">

    <Grid RowDefinitions="*, Auto">

        <!-- ═════════ MAPA ═════════ -->
        <Grid Grid.Row="0">
            <maps:Map x:Name="MapaConfirmar" IsShowingUser="True" MapType="{Binding CurrentMapType}" MapClicked="MapaConfirmar_MapClicked"/>

            <Border BackgroundColor="{AppThemeBinding Light=#EEFFFFFF, Dark=#EE1E1E1E}" StrokeShape="RoundRectangle 10" StrokeThickness="1" Stroke="{StaticResource Primary}" Margin="15" VerticalOptions="Start">
                <SearchBar x:Name="BuscadorConfirmar" Placeholder="{helpers:Translate Schedule_MapSearchPlaceholder}" SearchButtonPressed="BuscadorConfirmar_SearchButtonPressed" HeightRequest="45" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
            </Border>

            <VerticalStackLayout HorizontalOptions="End" VerticalOptions="Center" Margin="0,0,15,0" Spacing="15">
                <Button Text="🛰️" Command="{Binding ToggleMapTypeCommand}" WidthRequest="50" HeightRequest="50" CornerRadius="25" BackgroundColor="#CC000000" TextColor="White" FontSize="20"/>
                <!-- Agrandar / achicar el mapa (para celulares de pantalla chica) -->
                <Button Command="{Binding ToggleMapExpansionCommand}" WidthRequest="50" HeightRequest="50" CornerRadius="25" BackgroundColor="{StaticResource Primary}" TextColor="Black" FontAttributes="Bold" FontSize="18">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding ShowDetailsPanel}" Value="True">
                            <Setter Property="Text" Value="⤢" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding ShowDetailsPanel}" Value="False">
                            <Setter Property="Text" Value="⤡" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </VerticalStackLayout>

            <!-- Qué se está marcando ahora -->
            <Border HorizontalOptions="Center" VerticalOptions="End" Margin="15,0,15,15" BackgroundColor="#DD000000" StrokeShape="RoundRectangle 15" Padding="15,8" StrokeThickness="0">
                <Label Text="{Binding TextoAyudaMapa}" TextColor="White" FontAttributes="Bold" FontSize="13" HorizontalTextAlignment="Center"/>
            </Border>
        </Grid>

        <!-- ═════════ PANEL ═════════ -->
        <Border Grid.Row="1" StrokeShape="RoundRectangle 25,25,0,0" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}" StrokeThickness="0" IsVisible="{Binding ShowDetailsPanel}">
            <Grid RowDefinitions="Auto, Auto">

                <ScrollView Grid.Row="0" MaximumHeightRequest="400">
                    <VerticalStackLayout Padding="20,12" Spacing="14">

                        <BoxView HeightRequest="5" WidthRequest="40" Color="{AppThemeBinding Light=#CCCCCC, Dark=#444444}" CornerRadius="2" HorizontalOptions="Center"/>

                        <!-- Qué viajes se van a reservar -->
                        <Label Text="{Binding ResumenSeleccion}" FontSize="12" TextColor="{AppThemeBinding Light=#555555, Dark=#BBBBBB}"/>

                        <!-- Pestañas: casa / universidad -->
                        <Border StrokeShape="RoundRectangle 10" StrokeThickness="1" Stroke="{StaticResource Primary}" BackgroundColor="Transparent">
                            <Grid ColumnDefinitions="*,*">
                                <Button Grid.Column="0" Text="{Binding TabCasaTexto}" Command="{Binding VerCasaCommand}" FontSize="14" FontAttributes="Bold" CornerRadius="0" HeightRequest="46"
                                        BackgroundColor="{Binding EditandoCasa, Converter={StaticResource BoolToColorConverter}, ConverterParameter='Primary|Transparent'}"
                                        TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                                <Button Grid.Column="1" Text="{Binding TabUniversidadTexto}" Command="{Binding VerUniversidadCommand}" FontSize="14" FontAttributes="Bold" CornerRadius="0" HeightRequest="46"
                                        BackgroundColor="{Binding EditandoCasa, Converter={StaticResource BoolToColorConverter}, ConverterParameter='Transparent|Primary'}"
                                        TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                            </Grid>
                        </Border>

                        <!-- ── CASA ── -->
                        <VerticalStackLayout Spacing="8" IsVisible="{Binding EditandoCasa}">
                            <Label Text="{helpers:Translate Confirm_HomeHint}" FontSize="12" TextColor="{AppThemeBinding Light=#555555, Dark=#BBBBBB}"/>
                            <Label Text="{helpers:Translate Confirm_AddressLabel}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                            <Border StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="{AppThemeBinding Light=#DDDDDD, Dark=#555555}" Padding="10,0">
                                <Entry Text="{Binding AliasUbicacionPersonal}" Placeholder="{helpers:Translate Confirm_AddressPlaceholder}" MaxLength="80"
                                       TextColor="{AppThemeBinding Light=Black, Dark=White}" FontSize="14"/>
                            </Border>
                            <Label Text="{helpers:Translate Confirm_AddressWarning}" FontSize="11" TextColor="Gray"/>
                        </VerticalStackLayout>

                        <!-- ── PUNTO OFICIAL O ALTERNO (ej. Metrocentro) ── -->
                        <VerticalStackLayout Spacing="8" IsVisible="{Binding EditandoUniversidad}">
                            <Label Text="{helpers:Translate Confirm_AltHint}" FontSize="12" TextColor="{AppThemeBinding Light=#555555, Dark=#BBBBBB}"/>
                            <Label Text="{helpers:Translate Confirm_OfficialPointsLabel}" FontSize="13" FontAttributes="Bold" IsVisible="{Binding HayPuntosOficiales}" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                            <FlexLayout BindableLayout.ItemsSource="{Binding PuntosOficiales}" Wrap="Wrap" JustifyContent="Start" IsVisible="{Binding HayPuntosOficiales}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Button Text="{Binding Texto}" Margin="0,0,8,8" Padding="12,0" HeightRequest="40" FontSize="13" CornerRadius="20"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ConfirmarReservaViewModel}}, Path=SeleccionarPuntoOficialCommand}" CommandParameter="{Binding .}"
                                                BackgroundColor="{AppThemeBinding Light=#E3F2FD, Dark=#0D47A1}" TextColor="{AppThemeBinding Light=#0D47A1, Dark=White}"/>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                            <Label FontSize="13" TextColor="{AppThemeBinding Light=#0D47A1, Dark=#90CAF9}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{helpers:Translate Confirm_ChosenPrefix}" FontAttributes="Bold"/>
                                        <Span Text="{Binding TextoAlterno}"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </VerticalStackLayout>

                        <!-- ── MIS LUGARES (historial) ── -->
                        <VerticalStackLayout Spacing="6" IsVisible="{Binding HayLugares}">
                            <Label Text="{Binding TextoAyudaLugares}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                            <FlexLayout BindableLayout.ItemsSource="{Binding MisLugares}" Wrap="Wrap" JustifyContent="Start">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Button Text="{Binding Texto}" Margin="0,0,8,8" Padding="12,0" HeightRequest="40" FontSize="13" CornerRadius="20" LineBreakMode="TailTruncation" MaximumWidthRequest="300"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ConfirmarReservaViewModel}}, Path=SeleccionarLugarCommand}" CommandParameter="{Binding .}"
                                                BackgroundColor="{AppThemeBinding Light=#EEEEEE, Dark=#333333}" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>
                        <Label Text="{helpers:Translate Confirm_SavedPlacesHint}" FontSize="12" FontAttributes="Italic" TextColor="Gray"
                               IsVisible="{Binding HayLugares, Converter={StaticResource InvertedBoolConverter}}"/>

                        <!-- ── ESPEJO: cómo quedan recogida y bajada en cada dirección ── -->
                        <Border StrokeShape="RoundRectangle 12" StrokeThickness="1" Padding="12"
                                Stroke="{AppThemeBinding Light=#DDDDDD, Dark=#444444}" BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#252525}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="{helpers:Translate Confirm_SummaryTitle}" FontAttributes="Bold" FontSize="15" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                                <VerticalStackLayout Spacing="2" IsVisible="{Binding HayIda}">
                                    <Label Text="{helpers:Translate Confirm_InboundLabel}" FontAttributes="Bold" FontSize="13" TextColor="#2E7D32"/>
                                    <Label Text="{Binding EspejoIda}" FontSize="13" TextColor="{AppThemeBinding Light=#333333, Dark=#DDDDDD}"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Spacing="2" IsVisible="{Binding HayRegreso}">
                                    <Label Text="{helpers:Translate Confirm_OutboundLabel}" FontAttributes="Bold" FontSize="13" TextColor="#1565C0"/>
                                    <Label Text="{Binding EspejoRegreso}" FontSize="13" TextColor="{AppThemeBinding Light=#333333, Dark=#DDDDDD}"/>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <!-- ── REPETIR CADA SEMANA ── -->
                        <Border StrokeShape="RoundRectangle 12" Stroke="{StaticResource Primary}" StrokeThickness="2" Padding="15" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{helpers:Translate Confirm_RepeatTitle}" FontAttributes="Bold" FontSize="15" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                                <Label Text="{helpers:Translate Confirm_RepeatDesc}" FontSize="12" TextColor="Gray"/>
                                <Picker Title="{helpers:Translate Confirm_RepeatPickerTitle}" ItemsSource="{Binding OpcionesAlcance}" SelectedItem="{Binding AlcanceSeleccionado, Mode=TwoWay}"
                                        TextColor="{AppThemeBinding Light=Black, Dark=White}" TitleColor="{StaticResource Primary}"/>
                                <VerticalStackLayout Spacing="6" IsVisible="{Binding UsandoRangoPersonalizado}">
                                    <Label Text="{helpers:Translate Confirm_RepeatUntil}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                                    <Border BackgroundColor="{AppThemeBinding Light=#F5F7FA, Dark=#2C2C2C}" StrokeThickness="1" Stroke="{AppThemeBinding Light=#DDDDDD, Dark=#555555}" StrokeShape="RoundRectangle 8" Padding="10,0" HeightRequest="45">
                                        <DatePicker Date="{Binding FechaHastaPersonalizada}" MinimumDate="{Binding FechaMinimaRango}" MaximumDate="{Binding FechaMaximaRango}" Format="{helpers:Translate Fmt_DayMonthLong}"
                                                    TextColor="{AppThemeBinding Light=Black, Dark=White}" VerticalOptions="Center"/>
                                    </Border>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>
                </ScrollView>

                <Border Grid.Row="1" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}" Padding="15,10,15,20" StrokeThickness="0">
                    <Button Text="{helpers:Translate ConfirmarReserva_ConfirmarBtn}" Command="{Binding ConfirmarCommand}"
                            IsEnabled="{Binding IsSaving, Converter={StaticResource InvertedBoolConverter}}"
                            BackgroundColor="{StaticResource Primary}" TextColor="Black" FontAttributes="Bold" HeightRequest="52" CornerRadius="10"/>
                </Border>
            </Grid>
        </Border>

        <ActivityIndicator Grid.RowSpan="2" IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Color="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="50" HeightRequest="50"/>
        <ActivityIndicator Grid.RowSpan="2" IsRunning="{Binding IsSaving}" IsVisible="{Binding IsSaving}" Color="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="50" HeightRequest="50"/>
    </Grid>
</ContentPage>
