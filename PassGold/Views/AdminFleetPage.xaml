<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:PassGold.Helpers"
             x:Class="PassGold.Views.AdminFleetPage"
             xmlns:viewmodels="clr-namespace:PassGold.ViewModels"
             Title="{helpers:Translate AdminFleet_Title}"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightBg}, Dark={StaticResource DarkBg}}">

    <ContentPage.BindingContext>
        <viewmodels:AdminFleetViewModel />
    </ContentPage.BindingContext>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="25">

                <!-- ======================================================== -->
                <!--  VISTA COMPARTIDA: JEFES E INDEPENDIENTES (MICROBUSES) -->
                <!-- ======================================================== -->
                <VerticalStackLayout IsVisible="{Binding IsFleetManager}" Spacing="25">

                    <!--  NUEVO: LOGÍSTICA DE LA FLOTA (movido aqui desde Ajustes) -->
                    <VerticalStackLayout Spacing="15">
                        <Label Text="{helpers:Translate SettingsLogisticsTitle}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Primary}"/>
                        <Label Text="{helpers:Translate SettingsLogisticsDesc}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource LightTextSub}, Dark={StaticResource DarkTextSub}}"/>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="{helpers:Translate SettingsFleetNameLabel}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"/>
                            <Border Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" StrokeShape="RoundRectangle 8" Padding="10,0">
                                <Entry Text="{Binding NombreFlotaInput}" Placeholder="{helpers:Translate SettingsFleetNameHint}" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="{helpers:Translate SettingsPhoneLabel}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"/>
                            <Border Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" StrokeShape="RoundRectangle 8" Padding="10,0">
                                <Entry Text="{Binding TelefonoInput}" Keyboard="Telephone" Placeholder="Ej. 70001234" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}" />
                            </Border>
                        </VerticalStackLayout>

                        <!--  NUEVO: campo que faltaba, esto es lo que llena "Sobre Nosotros" en el perfil publico -->
                        <VerticalStackLayout Spacing="5">
                            <Label Text="{helpers:Translate Settings_DescriptionLabel}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"/>
                            <Border Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" StrokeShape="RoundRectangle 8" Padding="10">
                                <Editor Text="{Binding DescripcionInput}" Placeholder="{helpers:Translate Settings_DescriptionHint}" HeightRequest="90" AutoSize="TextChanges" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="{helpers:Translate SettingsRoutesLabel}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"/>
                            <Border Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" StrokeShape="RoundRectangle 8" Padding="10,0">
                                <Entry Text="{Binding NuevaRutaInput}" ReturnCommand="{Binding AgregarRutaTagCommand}" Placeholder="{helpers:Translate SettingsRoutesHint}" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}" />
                            </Border>
                            <FlexLayout BindableLayout.ItemsSource="{Binding RutasTags}" Wrap="Wrap" Direction="Row" Margin="0,5,0,0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource LightButtonSec}, Dark={StaticResource DarkButtonSec}}" Stroke="{StaticResource Primary}" StrokeThickness="1" StrokeShape="RoundRectangle 15" Padding="12,5" Margin="0,0,8,8">
                                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                                <Label Text="{Binding .}" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}" VerticalOptions="Center"/>
                                                <Label Text="✖" TextColor="{StaticResource Error}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center">
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:AdminFleetViewModel}}, Path=EliminarRutaTagCommand}" CommandParameter="{Binding .}"/>
                                                    </Label.GestureRecognizers>
                                                </Label>
                                            </HorizontalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>

                        <Button Text="{helpers:Translate SettingsSaveLogisticsBtn}" Command="{Binding SaveLogisticsCommand}" BackgroundColor="{StaticResource Primary}" TextColor="#000000" FontAttributes="Bold" CornerRadius="8" HeightRequest="45"/>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource LightDivider}, Dark={StaticResource DarkDivider}}"/>

                    <!-- ESTO SOLO LO VE EL JEFE (Códigos de invitación) -->
                    <Border IsVisible="{Binding IsBoss}" BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}" Stroke="{StaticResource Primary}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="20">
                        <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                            <Label Text="{helpers:Translate SettingsMyFleetTitle}" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource LightTextSub}, Dark={StaticResource DarkTextSub}}" HorizontalOptions="Center"/>
                            <Label Text="{Binding FleetCode}" FontSize="36" FontAttributes="Bold" TextColor="{StaticResource Primary}" HorizontalOptions="Center" CharacterSpacing="3"/>

                            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                                <Button Text="{helpers:Translate SettingsCopyBtn}" Command="{Binding CopyCodeCommand}" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}" FontSize="13" BorderColor="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" BorderWidth="1" HeightRequest="40" Padding="15,0" CornerRadius="8"/>
                                <Button Text="🔄 Regenerar" Command="{Binding RegenerateCodeCommand}" BackgroundColor="Transparent" TextColor="{StaticResource Error}" FontSize="13" BorderColor="{StaticResource Error}" BorderWidth="1" HeightRequest="40" Padding="15,0" CornerRadius="8"/>
                            </HorizontalStackLayout>

                            <Label Text="{helpers:Translate SettingsInviteDesc}" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource LightHint}, Dark={StaticResource DarkHint}}" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </Border>

                    <!--  MICROBUSES: LO VEN JEFES E INDEPENDIENTES -->
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <Label Grid.Column="0" Text="{helpers:Translate AdminFleet_MyBuses}" FontSize="20" FontAttributes="Bold" VerticalOptions="Center"/>
                        <Button Grid.Column="1" Text="{helpers:Translate AdminFleet_AddBtn}" Command="{Binding AddMicrobusCommand}" BackgroundColor="{StaticResource Primary}" TextColor="Black" CornerRadius="8" Padding="15,5" HeightRequest="40"/>
                    </Grid>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding MisMicrobuses}" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}" Padding="15">
                                    <Grid ColumnDefinitions="80, *, Auto">

                                        <!-- ESPACIO DE LA FOTO DEL MICROBÚS -->
                                        <Border Grid.Column="0" WidthRequest="70" HeightRequest="55" StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" VerticalOptions="Center" Margin="0,0,10,0" Padding="0">
                                            <Grid>
                                                <Label Text="🚐" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource LightHint}, Dark={StaticResource DarkHint}}"/>
                                                <Image Source="{Binding FotoUrl}" Aspect="AspectFill" />
                                            </Grid>
                                        </Border>

                                        <!-- DETALLES DEL VEHÍCULO -->
                                        <VerticalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                                            <Label Text="{Binding Placa}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Primary}"/>
                                            <Label Text="{Binding Capacidad, StringFormat='Capacidad: {0}'}" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource LightTextSub}, Dark={StaticResource DarkTextSub}}"/>
                                        </VerticalStackLayout>

                                        <!-- BOTONES DE EDITAR Y ELIMINAR -->
                                        <HorizontalStackLayout Grid.Column="2" Spacing="15" VerticalOptions="Center">
                                            <ImageButton WidthRequest="25" HeightRequest="25" BackgroundColor="Transparent" Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:AdminFleetViewModel}}, Path=EditarVehiculoCommand}" CommandParameter="{Binding .}">
                                                <ImageButton.Source>
                                                    <FontImageSource FontFamily="OpenSansRegular" Glyph="✏️" Color="{StaticResource Primary}"/>
                                                </ImageButton.Source>
                                            </ImageButton>
                                            <ImageButton WidthRequest="25" HeightRequest="25" BackgroundColor="Transparent" Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:AdminFleetViewModel}}, Path=EliminarVehiculoCommand}" CommandParameter="{Binding .}">
                                                <ImageButton.Source>
                                                    <FontImageSource FontFamily="OpenSansRegular" Glyph="🗑️" Color="{StaticResource Error}"/>
                                                </ImageButton.Source>
                                            </ImageButton>
                                        </HorizontalStackLayout>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!--  ESTO SOLO LO VE EL JEFE (Lista de Choferes) -->
                    <VerticalStackLayout IsVisible="{Binding IsBoss}" Spacing="10" Margin="0,10,0,0">
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource LightDivider}, Dark={StaticResource DarkDivider}}"/>

                        <Label Text="{helpers:Translate AdminFleet_MyDrivers}" FontSize="20" FontAttributes="Bold" Margin="0,10,0,0"/>

                        <VerticalStackLayout IsVisible="{Binding HasNoEmployees}" Spacing="10" Margin="0,10,0,0">
                            <Label Text="{helpers:Translate AdminFleet_NoEmployees}" FontAttributes="Italic" TextColor="{AppThemeBinding Light={StaticResource LightHint}, Dark={StaticResource DarkHint}}" HorizontalOptions="Center"/>
                            <Label Text="{helpers:Translate AdminFleet_Instructions}" FontSize="13" TextColor="{StaticResource Primary}" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding MisChoferes}" Spacing="10">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}" Padding="15">
                                        <Grid ColumnDefinitions="Auto, *, Auto">

                                            <!-- FOTO DEL EMPLEADO -->
                                            <Border Grid.Column="0" WidthRequest="50" HeightRequest="50" StrokeShape="RoundRectangle 25" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" VerticalOptions="Center" Margin="0,0,15,0" Padding="0">
                                                <Grid>
                                                    <Label Text="👤" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource LightHint}, Dark={StaticResource DarkHint}}"/>
                                                    <Image Source="{Binding FotoPerfil}" Aspect="AspectFill" />
                                                </Grid>
                                            </Border>

                                            <!-- DATOS DEL EMPLEADO -->
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                                <Label Text="{Binding Nombre}" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"/>
                                                <Label Text="{Binding Email}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource LightTextSub}, Dark={StaticResource DarkTextSub}}"/>
                                            </VerticalStackLayout>

                                            <!-- BOTÓN PARA SACAR EMPLEADO -->
                                            <ImageButton Grid.Column="2" VerticalOptions="Center" WidthRequest="30" HeightRequest="30" BackgroundColor="Transparent" Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:AdminFleetViewModel}}, Path=RemoverEmpleadoCommand}" CommandParameter="{Binding .}">
                                                <ImageButton.Source>
                                                    <FontImageSource FontFamily="OpenSansRegular" Glyph="🗑️" Color="{StaticResource Error}"/>
                                                </ImageButton.Source>
                                            </ImageButton>

                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- ======================================================== -->
                <!--  VISTA DEL EMPLEADO (Solo para unirse a flota) -->
                <!-- ======================================================== -->
                <VerticalStackLayout IsVisible="{Binding IsEmployee}" Spacing="25" VerticalOptions="CenterAndExpand">

                    <VerticalStackLayout IsVisible="{Binding HasJoinedFleet, Converter={StaticResource InvertedBoolConverter}}" Spacing="15" Margin="0,30,0,0">
                        <Label Text="🏢" FontSize="60" HorizontalOptions="Center"/>
                        <Label Text="{helpers:Translate MenuJoinFleet}" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center"/>
                        <Label Text="{helpers:Translate SettingsPasteDesc}" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource LightTextSub}, Dark={StaticResource DarkTextSub}}" HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="0,0,0,10"/>

                        <Border Stroke="{StaticResource Primary}" StrokeThickness="2" StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}" Padding="10,0">
                            <Entry Text="{Binding JoinCodeInput}" Placeholder="{helpers:Translate SettingsInputPlaceholder}" TextTransform="Uppercase" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center" MaxLength="6"/>
                        </Border>

                        <Label Text="{Binding JoinErrorMessage}" IsVisible="{Binding JoinErrorMessage, Converter={StaticResource StringToBoolConverter}}" TextColor="{StaticResource Error}" FontSize="12" HorizontalOptions="Center"/>

                        <Button Text="{helpers:Translate SettingsJoinBtn}" Command="{Binding JoinFleetCommand}" BackgroundColor="{StaticResource Primary}" TextColor="Black" FontSize="16" FontAttributes="Bold" CornerRadius="8" Margin="0,10,0,0" HeightRequest="50"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding HasJoinedFleet}" Spacing="15" Padding="0,40,0,0">
                        <Label Text="✅" FontSize="60" HorizontalOptions="Center"/>
                        <Label Text="{helpers:Translate Global_Ok}" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{StaticResource Primary}"/>
                        <Label Text="{Binding BossName, StringFormat='{0}'}" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Color="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="50" HeightRequest="50"/>
    </Grid>
</ContentPage>