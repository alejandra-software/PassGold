<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:PassGold.ViewModels"
             xmlns:helpers="clr-namespace:PassGold.Helpers"
             x:Class="PassGold.Views.DriverDashboardPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightBg}, Dark={StaticResource DarkBg}}">

    <Grid RowDefinitions="Auto, Auto, *">
        <Grid Grid.Row="0" ColumnDefinitions="Auto, Auto, *, Auto" ColumnSpacing="15" Padding="20,40,20,10">
            <ImageButton Grid.Column="0" Command="{Binding OpenSidebarCommand}" BackgroundColor="Transparent" VerticalOptions="Center">
                <ImageButton.Source>
                    <FontImageSource FontFamily="OpenSansRegular" Glyph="☰" Size="28" Color="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"/>
                </ImageButton.Source>
            </ImageButton>

            <Border Grid.Column="1" WidthRequest="40" HeightRequest="40" StrokeShape="RoundRectangle 20" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}">
                <Grid>
                    <Label Text="👤" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding HasFotoPerfilUsuario, Converter={StaticResource InvertedBoolConverter}}"/>
                    <Image Source="{Binding FotoPerfilUsuario}" Aspect="AspectFill" IsVisible="{Binding HasFotoPerfilUsuario}"/>
                </Grid>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenSidebarCommand}" />
                </Border.GestureRecognizers>
            </Border>

            <VerticalStackLayout Grid.Column="2" VerticalOptions="Center">
                <Label Text="{Binding DriverName}" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"/>
                <Label Text="{helpers:Translate Dashboard_OpsCenter}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource LightTextSub}, Dark={StaticResource DarkTextSub}}"/>
            </VerticalStackLayout>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*, *" Margin="20,10" BackgroundColor="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}">
            <Button Grid.Column="0" Text="{helpers:Translate Dashboard_OperationsToday}" Command="{Binding ToggleMainViewCommand}" CommandParameter="Hoy" BackgroundColor="{Binding IsTodayView, Converter={StaticResource BoolToColorConverter}, ConverterParameter='Primary|Transparent'}" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}" CornerRadius="0" FontAttributes="Bold"/>
            <Button Grid.Column="1" Text="{helpers:Translate Dashboard_MyWeek}" Command="{Binding ToggleMainViewCommand}" CommandParameter="Semana" BackgroundColor="{Binding IsWeeklyView, Converter={StaticResource BoolToColorConverter}, ConverterParameter='Primary|Transparent'}" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}" CornerRadius="0" FontAttributes="Bold"/>
        </Grid>

        <Grid Grid.Row="2" VerticalOptions="Fill">

            <RefreshView IsVisible="{Binding IsTodayView}" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshDashboardCommand}" RefreshColor="{StaticResource Primary}">
                <ScrollView VerticalOptions="Fill">
                    <VerticalStackLayout Padding="10" Spacing="10">
                        <Label IsVisible="{Binding HasViajeEnCurso, Converter={StaticResource InvertedBoolConverter}}" Text="{helpers:Translate Dashboard_NoTripsToday}" HorizontalOptions="Center" Margin="0,20" TextColor="{AppThemeBinding Light={StaticResource LightHint}, Dark={StaticResource DarkHint}}"/>

                        <VerticalStackLayout IsVisible="{Binding HasViajeEnCurso}" Spacing="10">
                            <Label Text="{helpers:Translate Dashboard_TripsInProgress}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Primary}" Margin="10,0"/>
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding ViajesEnCursoAhora}" Spacing="10">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}" Stroke="{StaticResource Primary}" StrokeThickness="2" StrokeShape="RoundRectangle 12" Padding="20">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:DriverDashboardViewModel}}, Path=VerDetalleViajeCommand}" CommandParameter="{Binding IdAsignacion}"/>
                                            </Border.GestureRecognizers>
                                            <Grid ColumnDefinitions="Auto, *">
                                                <Border Grid.Column="0" WidthRequest="60" HeightRequest="60" StrokeShape="RoundRectangle 10" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" Margin="0,0,15,0" VerticalOptions="Center">
                                                    <Label Text="🚐" FontSize="30" HorizontalOptions="Center" VerticalOptions="Center"/>
                                                </Border>
                                                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                                    <Border BackgroundColor="{Binding ColorBadge}" StrokeThickness="0" StrokeShape="RoundRectangle 4" Padding="5,2" HorizontalOptions="Start">
                                                        <Label Text="{Binding TipoViajeBadge}" FontSize="12" FontAttributes="Bold" TextColor="White"/>
                                                    </Border>
                                                    <Label Text="{Binding HoraContextual}" FontAttributes="Bold" FontSize="18" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"/>
                                                    <HorizontalStackLayout Spacing="10" Margin="0,5,0,0">
                                                        <Label Text="{Binding PlacaMicrobus}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Primary}"/>
                                                        <Label Text="{Binding OcupacionActual, StringFormat='{0} Pasajeros'}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource LightTextSub}, Dark={StaticResource DarkTextSub}}"/>
                                                    </HorizontalStackLayout>
                                                </VerticalStackLayout>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <VerticalStackLayout IsVisible="{Binding HasProximoViajeHoy}" Spacing="10">
                            <Label Text="{helpers:Translate Dashboard_NextTrip}" FontSize="15" TextColor="{AppThemeBinding Light={StaticResource LightHint}, Dark={StaticResource DarkHint}}" Margin="10,0"/>
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}" Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="15">
                                <Grid ColumnDefinitions="Auto, *">
                                    <Label Grid.Column="0" Text="🕐" FontSize="24" Margin="0,0,15,0" VerticalOptions="Center"/>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="{Binding ProximoViajeHoy.HoraContextual}" FontAttributes="Bold" FontSize="16" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <Grid RowDefinitions="Auto, Auto" Margin="10,20,10,0" IsVisible="{Binding HasViajesHoy}">
                            <Label Grid.Row="0" Text="{helpers:Translate Dashboard_PassengerList}" FontSize="16" FontAttributes="Bold" Margin="0,0,0,10" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"/>
                            <VerticalStackLayout Grid.Row="1" BindableLayout.ItemsSource="{Binding PasajerosDelViaje}" Spacing="10">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Border StrokeThickness="1" StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}" Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" Padding="15,10">
                                            <Grid ColumnDefinitions="Auto, *">
                                                <Label Grid.Column="0" Text="👤" FontSize="24" Margin="0,0,15,0" VerticalOptions="Center"/>
                                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                                    <Label Text="{Binding Nombre}" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"/>
                                                    <Label Text="{Binding Ubicacion}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource LightHint}, Dark={StaticResource DarkHint}}"/>
                                                </VerticalStackLayout>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </ScrollView>
            </RefreshView>

            <Grid IsVisible="{Binding IsWeeklyView}" RowDefinitions="Auto, Auto, *" VerticalOptions="Fill">

                <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="10,0,10,10">
                    <Button Grid.Column="0" Text="◀" Command="{Binding RetrocederSemanaCommand}" BackgroundColor="Transparent" TextColor="{StaticResource Primary}" FontSize="20"/>
                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="{helpers:Translate Dashboard_WeeklySchedule}" FontAttributes="Bold" FontSize="15" HorizontalOptions="Center"/>
                        <Label Text="{Binding TextoRangoFechas}" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource LightHint}, Dark={StaticResource DarkHint}}" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                    <Button Grid.Column="2" Text="▶" Command="{Binding AvanzarSemanaCommand}" BackgroundColor="Transparent" TextColor="{StaticResource Primary}" FontSize="20"/>
                </Grid>

                <Label Grid.Row="1" IsVisible="{Binding IsScheduleEmpty}" Text="{helpers:Translate Dashboard_EmptySchedule}" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,20" TextColor="{AppThemeBinding Light={StaticResource LightHint}, Dark={StaticResource DarkHint}}"/>

                <ScrollView Grid.Row="2" VerticalOptions="Fill" IsVisible="{Binding IsScheduleEmpty, Converter={StaticResource InvertedBoolConverter}}">
                    <Grid ColumnDefinitions="75, *" Padding="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="5" Margin="0,45,0,0" BindableLayout.ItemsSource="{Binding TramosDelDia}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border HeightRequest="160" BackgroundColor="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" StrokeThickness="0" StrokeShape="RoundRectangle 8,0,0,8" Padding="5">
                                        <Label Text="{Binding HoraFija}" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource LightTextSub}, Dark={StaticResource DarkTextSub}}" HorizontalOptions="Center" VerticalOptions="Center" HorizontalTextAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <ScrollView Grid.Column="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Always">
                            <VerticalStackLayout Spacing="5">
                                <HorizontalStackLayout Spacing="5" BindableLayout.ItemsSource="{Binding CabecerasDias}" HeightRequest="45">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Border WidthRequest="180" HeightRequest="45" BackgroundColor="{StaticResource Primary}" StrokeShape="RoundRectangle 8" Padding="5,0" StrokeThickness="0">
                                                <Label Text="{Binding .}" TextColor="#000000" FontAttributes="Bold" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </HorizontalStackLayout>

                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding TramosDelDia}" Spacing="5">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding ViajesDeLaSemana}" Spacing="5">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate>
                                                        <!--  FIX: antes este Border bindeaba ChoferInfo/IdAsignacion/ColorFondo/TipoViajeBadge
                                                             directo sobre el BloqueViaje, que NO tiene esas propiedades (solo tiene
                                                             TieneViaje y Opciones). Por eso IdAsignacion resolvía a null, el botón
                                                             "Editar" navegaba con id=null, no encontraba nada en _asignacionesCacheadas,
                                                             y no pasaba nada al tocarlo. Ahora se agrega el BindableLayout que faltaba
                                                             sobre "Opciones" (ObservableCollection<OpcionViajeChofer>), que sí tiene esas
                                                             propiedades. De paso, esto también soporta mostrar varios microbuses de apoyo
                                                             apilados si hay más de uno en el mismo bloque de día/hora. -->
                                                        <Border WidthRequest="180" HeightRequest="160" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                                                            <Grid>
                                                                <ScrollView IsVisible="{Binding TieneViaje}">
                                                                    <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding Opciones}">
                                                                        <BindableLayout.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}" Stroke="{StaticResource Primary}" StrokeThickness="1" Padding="5">
                                                                                    <Border.GestureRecognizers>
                                                                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:DriverDashboardViewModel}}, Path=VerDetalleViajeCommand}" CommandParameter="{Binding IdAsignacion}"/>
                                                                                    </Border.GestureRecognizers>
                                                                                    <Border BackgroundColor="{Binding ColorFondo}" StrokeThickness="0" StrokeShape="RoundRectangle 4" Padding="5">
                                                                                        <Grid RowDefinitions="Auto, Auto">
                                                                                            <HorizontalStackLayout Grid.Row="0" Spacing="5">
                                                                                                <Label Text="{Binding ChoferInfo}" FontSize="12" FontAttributes="Bold" TextColor="White" LineBreakMode="TailTruncation" VerticalOptions="Center"/>
                                                                                                <Border BackgroundColor="#222222" StrokeThickness="0" StrokeShape="RoundRectangle 4" Padding="4,2" VerticalOptions="Center">
                                                                                                    <Label Text="{Binding TipoViajeBadge}" FontSize="9" FontAttributes="Bold" TextColor="White"/>
                                                                                                </Border>
                                                                                            </HorizontalStackLayout>
                                                                                            <HorizontalStackLayout Grid.Row="1" Spacing="5" Margin="0,5,0,0">
                                                                                                <Button Text="✏️ Editar" IsVisible="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:DriverDashboardViewModel}}, Path=CanScheduleTrips}" Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:DriverDashboardViewModel}}, Path=NavegarAEdicionCommand}" CommandParameter="{Binding IdAsignacion}" HeightRequest="25" FontSize="10" CornerRadius="4" BackgroundColor="#FFF3E0" TextColor="#D32F2F" Padding="5,0"/>
                                                                                                <Button Text="Detalle" Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:DriverDashboardViewModel}}, Path=VerDetalleViajeCommand}" CommandParameter="{Binding IdAsignacion}" HeightRequest="25" FontSize="10" CornerRadius="4" BackgroundColor="#E0F7FA" TextColor="#00796B" Padding="5,0"/>
                                                                                            </HorizontalStackLayout>
                                                                                        </Grid>
                                                                                    </Border>
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </BindableLayout.ItemTemplate>
                                                                    </VerticalStackLayout>
                                                                </ScrollView>
                                                                <Border IsVisible="{Binding TieneViaje, Converter={StaticResource InvertedBoolConverter}}" BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}" StrokeThickness="0" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </HorizontalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </ScrollView>
                    </Grid>
                </ScrollView>
            </Grid>

            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Color="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="50" HeightRequest="50"/>
        </Grid>
    </Grid>
</ContentPage>
