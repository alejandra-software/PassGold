<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Ícono: debe coincidir con el nombre del archivo de MauiIcon (logo.png) -->
	<key>XSAppIconAssets</key>
	<string>Assets.xcassets/logo.appiconset</string>

	<!-- INICIO CONFIGURACIÓN LOGIN SOCIAL (GOOGLE/APPLE) -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>PassGold Auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>goldeenride</string>
			</array>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
		</dict>
	</array>
	<!-- FIN CONFIGURACIÓN LOGIN SOCIAL -->

	<!-- Permiso obligatorio de ubicación (Actualizado para el rastreador de choferes) -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>PassGold necesita tu ubicación para mostrarte en el mapa y, si eres chofer, transmitir tu distancia en tiempo real a tus pasajeros durante un viaje para que salgan a tiempo.</string>

	<key>NSPhotoLibraryUsageDescription</key>
	<string>PassGold necesita acceder a tus fotos para que puedas subir tu foto de perfil o la del microbús.</string>
	<key>NSCameraUsageDescription</key>
	<string>PassGold necesita acceder a la cámara para que puedas tomar una foto de perfil o del microbús.</string>

</dict>
</plist>