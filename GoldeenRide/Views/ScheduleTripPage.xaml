<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GoldeenRide.Views.ScheduleTripPage"
             xmlns:viewmodels="clr-namespace:GoldeenRide.ViewModels"
             xmlns:helpers="clr-namespace:GoldeenRide.Helpers"
             Title="{helpers:Translate Schedule_Title}"
             BackgroundColor="{AppThemeBinding Light=#F5F7FA, Dark=#121212}">

    <ContentPage.BindingContext>
        <viewmodels:ScheduleTripViewModel />
    </ContentPage.BindingContext>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="20">

                <Label Text="{helpers:Translate Schedule_Section1}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Primary}"/>

                <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                    <VerticalStackLayout Grid.Column="0" Spacing="5">
                        <Label Text="{helpers:Translate Schedule_TripType}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource LightTextSub}, Dark={StaticResource DarkTextSub}}"/>
                        <Border Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" StrokeShape="RoundRectangle 8" Padding="10,0">
                            <Picker ItemsSource="{Binding TiposViaje}" SelectedItem="{Binding SelectedTipoViaje}"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                        <Label Text="{helpers:Translate Schedule_DepartureTime}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource LightTextSub}, Dark={StaticResource DarkTextSub}}"/>
                        <Border Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" StrokeShape="RoundRectangle 8" Padding="10,0">
                            <TimePicker Time="{Binding HoraSalida}" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <!-- 🔥 NUEVO: Ventana real de ejecución del viaje (para "Operación de Hoy") 🔥 -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="{helpers:Translate Schedule_RealWindowHint}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource LightTextSub}, Dark={StaticResource DarkTextSub}}"/>
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                        <VerticalStackLayout Grid.Column="0" Spacing="5">
                            <Label Text="{helpers:Translate Schedule_RealStartTime}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource LightTextSub}, Dark={StaticResource DarkTextSub}}"/>
                            <Border Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" StrokeShape="RoundRectangle 8" Padding="10,0">
                                <TimePicker Time="{Binding HoraInicioRecorrido}" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="5">
                            <Label Text="{helpers:Translate Schedule_RealArrivalTime}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource LightTextSub}, Dark={StaticResource DarkTextSub}}"/>
                            <Border Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" StrokeShape="RoundRectangle 8" Padding="10,0">
                                <TimePicker Time="{Binding HoraLlegadaDestino}" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5">
                    <Label Text="{helpers:Translate Schedule_GeneralRoute}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource LightTextSub}, Dark={StaticResource DarkTextSub}}"/>
                    <Border Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" StrokeShape="RoundRectangle 8" Padding="10,0">
                        <Entry Text="{Binding RutaTexto}" Placeholder="{helpers:Translate Schedule_RoutePlaceholder}" />
                    </Border>
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                    <VerticalStackLayout Grid.Column="0" Spacing="5">
                        <Label Text="{helpers:Translate Schedule_StartsOn}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource LightTextSub}, Dark={StaticResource DarkTextSub}}"/>
                        <Border Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" StrokeShape="RoundRectangle 8" Padding="10,0">
                            <DatePicker Date="{Binding FechaInicio}" Format="dd/MMM/yy"/>
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                        <Label Text="{helpers:Translate Schedule_EndsOn}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource LightTextSub}, Dark={StaticResource DarkTextSub}}"/>
                        <Border Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" StrokeShape="RoundRectangle 8" Padding="10,0">
                            <DatePicker Date="{Binding FechaFin}" Format="dd/MMM/yy"/>
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <VerticalStackLayout Spacing="5">
                    <Label Text="{helpers:Translate Schedule_Weekdays}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource LightTextSub}, Dark={StaticResource DarkTextSub}}"/>
                    <Grid ColumnDefinitions="*,*,*,*,*,*,*">
                        <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center">
                            <Label Text="L"/>
                            <CheckBox IsChecked="{Binding DiaL}" Color="{StaticResource Primary}"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                            <Label Text="M"/>
                            <CheckBox IsChecked="{Binding DiaM}" Color="{StaticResource Primary}"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center">
                            <Label Text="Mi"/>
                            <CheckBox IsChecked="{Binding DiaMi}" Color="{StaticResource Primary}"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center">
                            <Label Text="J"/>
                            <CheckBox IsChecked="{Binding DiaJ}" Color="{StaticResource Primary}"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="4" HorizontalOptions="Center">
                            <Label Text="V"/>
                            <CheckBox IsChecked="{Binding DiaV}" Color="{StaticResource Primary}"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="5" HorizontalOptions="Center">
                            <Label Text="S"/>
                            <CheckBox IsChecked="{Binding DiaS}" Color="{StaticResource Primary}"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="6" HorizontalOptions="Center">
                            <Label Text="D"/>
                            <CheckBox IsChecked="{Binding DiaD}" Color="{StaticResource Primary}"/>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>

                <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource LightDivider}, Dark={StaticResource DarkDivider}}" Margin="0,5"/>

                <Label Text="{helpers:Translate Schedule_Section2}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Primary}"/>

                <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" ColumnSpacing="10" RowSpacing="10">
                    <Border Grid.Row="0" Grid.Column="0" Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" StrokeShape="RoundRectangle 8" Padding="10,0">
                        <Picker ItemsSource="{Binding ChoferesDisponibles}" SelectedItem="{Binding SelectedChofer}" ItemDisplayBinding="{Binding Nombre}" Title="Chofer" />
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0" Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" StrokeShape="RoundRectangle 8" Padding="10,0">
                        <Picker ItemsSource="{Binding VehiculosDisponibles}" SelectedItem="{Binding SelectedVehiculo}" ItemDisplayBinding="{Binding Placa}" Title="Microbús" />
                    </Border>

                    <Button Grid.RowSpan="2" Grid.Column="1" Text="➕" FontSize="20" Command="{Binding AddAsignacionCommand}" BackgroundColor="{StaticResource Primary}" TextColor="Black" CornerRadius="8" WidthRequest="60" HeightRequest="90"/>
                </Grid>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Asignaciones}" Spacing="10" Margin="0,10,0,0">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border Stroke="{StaticResource Primary}" StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light={StaticResource LightButtonSec}, Dark={StaticResource DarkButtonSec}}" Padding="15,10">
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label Grid.Column="0" Text="{Binding Detalles}" VerticalOptions="Center" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"/>
                                    <ImageButton Grid.Column="1" WidthRequest="24" HeightRequest="24" Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ScheduleTripViewModel}}, Path=RemoveAsignacionCommand}" CommandParameter="{Binding .}">
                                        <ImageButton.Source>
                                            <FontImageSource FontFamily="OpenSansRegular" Glyph="❌" Color="{StaticResource Error}"/>
                                        </ImageButton.Source>
                                    </ImageButton>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Button Text="{helpers:Translate Schedule_PublishTrips}" Command="{Binding SaveTripCommand}" BackgroundColor="{StaticResource Primary}" TextColor="#000000" FontAttributes="Bold" CornerRadius="8" HeightRequest="50" Margin="0,20,0,0"/>

            </VerticalStackLayout>
        </ScrollView>

        <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Color="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="50" HeightRequest="50"/>
    </Grid>
</ContentPage>